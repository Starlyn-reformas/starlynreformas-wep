{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stralyn-reformas-wep",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "routes": [
    {
      "pattern": "starlynreformas.com",
      "custom_domain": true
    },
    {
      "pattern": "www.starlynreformas.com",
      "custom_domain": true
    }
  ]
}