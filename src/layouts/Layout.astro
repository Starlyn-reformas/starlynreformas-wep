		<script is:inline>
			(function () {
				/* =========================================
				   DROPDOWN SERVICIOS DESKTOP
				========================================== */
				function initServicesMenu() {
					var button = document.getElementById("services-button");
					var menu = document.getElementById("services-menu");
					var container = document.getElementById("desktop-services");
					var chevron = document.getElementById("services-chevron");

					if (!button || !menu || !container) return;

					function openMenu() {
						menu.classList.remove(
							"invisible",
							"opacity-0",
							"translate-y-1"
						);

						menu.classList.add(
							"visible",
							"opacity-100",
							"translate-y-0"
						);

						button.setAttribute("aria-expanded", "true");

						if (chevron) {
							chevron.classList.add("rotate-180");
						}
					}

					function closeMenu() {
						menu.classList.add(
							"invisible",
							"opacity-0",
							"translate-y-1"
						);

						menu.classList.remove(
							"visible",
							"opacity-100",
							"translate-y-0"
						);

						button.setAttribute("aria-expanded", "false");

						if (chevron) {
							chevron.classList.remove("rotate-180");
						}
					}

					button.addEventListener("click", function (event) {
						event.stopPropagation();

						var expanded =
							button.getAttribute("aria-expanded") === "true";

						if (expanded) {
							closeMenu();
						} else {
							openMenu();
						}
					});

					document.addEventListener("click", function (event) {
						var target = event.target;

						if (
							target instanceof Node &&
							!container.contains(target)
						) {
							closeMenu();
						}
					});

					document.addEventListener("keydown", function (event) {
						if (event.key === "Escape") {
							closeMenu();
							button.focus();
						}
					});
				}

				/* =========================================
				   MENÚ MÓVIL
				========================================== */
				function initMobileMenu() {
					var button = document.getElementById("mobile-menu-button");
					var menu = document.getElementById("mobile-menu");
					var iconOpen = document.getElementById("mobile-menu-icon-open");
					var iconClose = document.getElementById("mobile-menu-icon-close");

					if (!button || !menu) return;

					function closeMobileMenu() {
						menu.classList.add("hidden");
						button.setAttribute("aria-expanded", "false");
						button.setAttribute("aria-label", "Abrir menú");

						if (iconOpen) {
							iconOpen.classList.remove("hidden");
						}

						if (iconClose) {
							iconClose.classList.add("hidden");
						}
					}

					function openMobileMenu() {
						menu.classList.remove("hidden");
						button.setAttribute("aria-expanded", "true");
						button.setAttribute("aria-label", "Cerrar menú");

						if (iconOpen) {
							iconOpen.classList.add("hidden");
						}

						if (iconClose) {
							iconClose.classList.remove("hidden");
						}
					}

					button.addEventListener("click", function () {
						var expanded =
							button.getAttribute("aria-expanded") === "true";

						if (expanded) {
							closeMobileMenu();
						} else {
							openMobileMenu();
						}
					});

					var mobileLinks = menu.querySelectorAll("a");

					mobileLinks.forEach(function (link) {
						link.addEventListener("click", function () {
							closeMobileMenu();
						});
					});

					window.addEventListener("resize", function () {
						if (window.innerWidth >= 768) {
							closeMobileMenu();
						}
					});

					document.addEventListener("keydown", function (event) {
						if (event.key === "Escape") {
							closeMobileMenu();
						}
					});
				}

				/* =========================================
				   AUTOCOMPLETADO DE ZONA / DIRECCIÓN
				========================================== */
				function initAutocomplete() {
					var input = document.getElementById("barrio-input");
					var resultsList =
						document.getElementById("direccion-results");
					var wrapper =
						document.getElementById("autocomplete-wrapper");

					if (!input || !resultsList || !wrapper) return;

					var zonasZaragoza = [
						"Actur",
						"Centro / Paseo Sagasta",
						"Delicias",
						"Romareda",
						"San José",
						"Las Fuentes",
						"Santa Isabel",
						"Valdespartera",
						"Montecanal",
						"Miralbueno",
						"El Oliver",
						"Torrero / La Paz",
						"Almozara",
						"Calle Antonio Bravo, Zaragoza",
						"Calle Antonio Cánovas, Zaragoza",
						"Paseo Independencia, Zaragoza",
						"Gran Vía, Zaragoza",
						"Calle Alfonso I, Zaragoza",
						"Calle Don Jaime I, Zaragoza",
						"Avenida de Madrid, Zaragoza",
						"Avenida Navarra, Zaragoza",
					];

					function filterAndShow(query) {
						var cleanQuery = query.toLowerCase().trim();

						resultsList.innerHTML = "";

						if (!cleanQuery) {
							resultsList.classList.add("hidden");
							return;
						}

						var matches = zonasZaragoza.filter(function (item) {
							return (
								item
									.toLowerCase()
									.indexOf(cleanQuery) !== -1
							);
						});

						if (matches.length > 0) {
							matches.forEach(function (zona) {
								var li = document.createElement("li");

								li.className =
									"p-3 hover:bg-amber-50 cursor-pointer text-sm text-slate-700 flex items-center gap-2 transition-colors border-b border-slate-100 last:border-0";

								li.setAttribute("role", "option");

								var icon = document.createElement("span");
								icon.className = "text-amber-500";
								icon.textContent = "📍";

								var text = document.createElement("span");
								text.textContent = zona;

								li.appendChild(icon);
								li.appendChild(text);

								li.addEventListener(
									"mousedown",
									function (event) {
										event.preventDefault();

										input.value = zona;
										resultsList.classList.add("hidden");
									}
								);

								resultsList.appendChild(li);
							});

							resultsList.classList.remove("hidden");
						} else {
							resultsList.classList.add("hidden");
						}
					}

					input.addEventListener("input", function (event) {
						var target = event.target;

						if (target instanceof HTMLInputElement) {
							filterAndShow(target.value);
						}
					});

					input.addEventListener("focus", function () {
						if (input.value.trim()) {
							filterAndShow(input.value);
						}
					});

					document.addEventListener("click", function (event) {
						var target = event.target;

						if (
							target instanceof Node &&
							!wrapper.contains(target)
						) {
							resultsList.classList.add("hidden");
						}
					});
				}

				function initAll() {
					initServicesMenu();
					initMobileMenu();
					initAutocomplete();
				}

				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", initAll);
				} else {
					initAll();
				}
			})();
		</script>
	</body>
</html>