---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
}

const {
	title,
	description = "STARLYN REFORMAS. Reformas integrales, baños, cocinas, fontanería, electricidad, pladur y alicatados. Zaragoza y alrededores. Solicita tu presupuesto personalizado.",
	canonical,
	ogImage = "/images/logo-starlyn-reformas.png",
} = Astro.props;

/*
 * URL BASE
 * Mientras no exista dominio definitivo, usamos automáticamente
 * la URL disponible en Astro.
 */
const siteUrl = (Astro.site?.toString() || Astro.url.origin).replace(/\/$/, "");

const canonicalUrl = canonical
	? new URL(canonical, siteUrl).toString()
	: new URL(Astro.url.pathname, siteUrl).toString();

const absoluteOgImage = ogImage.startsWith("http")
	? ogImage
	: `${siteUrl}${ogImage}`;

/*
 * DATOS ESTRUCTURADOS
 * Datos reales de STARLYN REFORMAS.
 */
const businessSchema = {
	"@context": "https://schema.org",
	"@type": ["HomeAndConstructionBusiness", "GeneralContractor"],
	"name": "STARLYN REFORMAS",
	"url": canonicalUrl,
	"logo": absoluteOgImage,
	"image": absoluteOgImage,
	"telephone": "+34614783004",
	"email": "starlynreformas.ai@gmail.com",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "Calle Antonio Bravo 22",
		"postalCode": "50017",
		"addressLocality": "Zaragoza",
		"addressRegion": "Aragón",
		"addressCountry": "ES",
	},
	"serviceType": [
		"Reformas integrales",
		"Reformas de baños",
		"Reformas de cocinas",
		"Fontanería",
		"Electricidad",
		"Pladur",
		"Alicatados",
	],
	"areaServed": [
		{
			"@type": "AdministrativeArea",
			"name": "Zaragoza",
		},
		{
			"@type": "AdministrativeArea",
			"name": "Aragón",
		},
	],
};
