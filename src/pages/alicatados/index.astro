---
import Layout from '../../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

import {
  Grid3X3,
  Layers3,
  SquareStack,
  Ruler,
  ShieldCheck,
  ClipboardCheck,
  ArrowRight,
  Phone,
  MapPin,
  Check,
  Home,
  Wrench,
  Bath,
  Utensils,
} from '@lucide/astro';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY
);

const {
  data: proyectosAlicatados,
  error: proyectosAlicatadosError,
} = await supabase
  .from('proyectos')
  .select(
    'id, titulo, descripcion, categoria, imagen, orden, created_at'
  )
  .eq('categoria', 'Alicatados')
  .eq('publicado', true)
  .not('imagen', 'is', null)
  .order('orden', { ascending: true })
  .order('created_at', { ascending: false })
  .limit(6);

const trabajosAlicatados = proyectosAlicatados ?? [];

if (proyectosAlicatadosError) {
  console.error(
    'Error cargando proyectos de alicatados:',
    proyectosAlicatadosError
  );
}
---
<Layout
  title="Alicatados en Zaragoza | Colocación de Azulejos | STARLYN REFORMAS"
  description="Servicios de alicatado en Zaragoza y alrededores. Colocación y renovación de revestimientos y azulejos para baños, cocinas y diferentes espacios."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section class="relative overflow-hidden bg-[#102a43] text-white">

    <div class="absolute inset-0 opacity-20">
      <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-[#b58a3a] blur-3xl"></div>
      <div class="absolute -bottom-32 -left-20 h-72 w-72 rounded-full bg-[#294d67] blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-24 lg:px-8">

      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">

        <div class="max-w-3xl">

          <div class="mb-5 flex items-center gap-3">
            <span class="h-px w-10 bg-[#d2b06a]"></span>

            <span class="text-xs font-bold uppercase tracking-[0.22em] text-[#d2b06a]">
              Alicatados y revestimientos
            </span>
          </div>

          <h1 class="text-4xl font-black leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            Alicatados en
            <span class="text-[#d2b06a]">
              Zaragoza
            </span>
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[#dbe4ea] sm:text-xl">
            Renovamos paredes y superficies con soluciones de alicatado para
            baños, cocinas y otros espacios, cuidando la preparación,
            colocación y acabado final.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">

            <a
              href="#contacto"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#b58a3a] px-6 py-3.5 font-bold text-white shadow-lg shadow-black/10 hover:bg-[#d2b06a]"
            >
              Solicitar presupuesto

              <ArrowRight
                class="h-5 w-5"
                strokeWidth={1.8}
              />
            </a>

            <a
              href="/#contacto"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/5 px-6 py-3.5 font-semibold text-white hover:border-[#d2b06a] hover:bg-white/10"
            >
              Ver contacto
            </a>

          </div>

          <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-[#dbe4ea]">

            <div class="flex items-center gap-2">
              <Check
                class="h-4 w-4 text-[#d2b06a]"
                strokeWidth={2}
              />
              12+ años de experiencia
            </div>

            <div class="flex items-center gap-2">
              <Check
                class="h-4 w-4 text-[#d2b06a]"
                strokeWidth={2}
              />
              Zaragoza y alrededores
            </div>

          </div>

        </div>


        <!-- BLOQUE VISUAL -->

        <div class="relative">

          <div class="overflow-hidden rounded-3xl border border-white/10 bg-white/5 shadow-2xl">

            <div class="flex min-h-[360px] items-center justify-center bg-gradient-to-br from-[#173b57] to-[#102a43] p-8">

              <div class="text-center">

                <Grid3X3
                  class="mx-auto h-24 w-24 text-[#d2b06a]"
                  strokeWidth={1.1}
                />

                <p class="mt-6 text-xl font-bold text-white">
                  Alicatados y revestimientos
                </p>

                <p class="mt-2 text-sm leading-relaxed text-[#cbd7df]">
                  Acabados para baños, cocinas y otros espacios
                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       SERVICIOS
       ===================================================== -->

  <section class="bg-[#f7f4ee] py-16 md:py-20">

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <div class="mx-auto max-w-2xl text-center">

        <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#b58a3a]">
          Servicios
        </span>

        <h2 class="mt-3 text-3xl font-black tracking-tight text-[#102a43] sm:text-4xl">
          Soluciones de alicatado para tu proyecto
        </h2>

        <p class="mt-4 text-base leading-relaxed text-[#687078]">
          Adaptamos el trabajo a las características de cada espacio,
          cuidando tanto la colocación como el resultado final.
        </p>

      </div>


      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">


        <!-- BAÑOS -->

        <article class="group rounded-2xl border border-[#e8ded0] bg-white p-7 shadow-sm hover:border-[#d2b06a]">

          <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-[#f1ebe2] text-[#b58a3a]">

            <Bath
              class="h-8 w-8"
              strokeWidth={1.35}
            />

          </div>

          <h3 class="mt-6 text-xl font-bold text-[#102a43]">
            Alicatado de baños
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-[#687078]">
            Renovación de paredes y superficies de baños dentro de proyectos
            de reforma y actualización del espacio.
          </p>

        </article>


        <!-- COCINAS -->

        <article class="group rounded-2xl border border-[#e8ded0] bg-white p-7 shadow-sm hover:border-[#d2b06a]">

          <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-[#f1ebe2] text-[#b58a3a]">

            <Utensils
              class="h-8 w-8"
              strokeWidth={1.35}
            />

          </div>

          <h3 class="mt-6 text-xl font-bold text-[#102a43]">
            Alicatado de cocinas
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-[#687078]">
            Revestimientos para cocinas y zonas de trabajo, integrados con
            la distribución y el diseño del espacio.
          </p>

        </article>


        <!-- REVESTIMIENTOS -->

        <article class="group rounded-2xl border border-[#e8ded0] bg-white p-7 shadow-sm hover:border-[#d2b06a]">

          <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-[#f1ebe2] text-[#b58a3a]">

            <Layers3
              class="h-8 w-8"
              strokeWidth={1.35}
            />

          </div>

          <h3 class="mt-6 text-xl font-bold text-[#102a43]">
            Revestimientos
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-[#687078]">
            Colocación de revestimientos en diferentes superficies interiores
            según las características del proyecto.
          </p>

        </article>


        <!-- RENOVACIÓN -->

        <article class="group rounded-2xl border border-[#e8ded0] bg-white p-7 shadow-sm hover:border-[#d2b06a]">

          <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-[#f1ebe2] text-[#b58a3a]">

            <Grid3X3
              class="h-8 w-8"
              strokeWidth={1.35}
            />

          </div>

          <h3 class="mt-6 text-xl font-bold text-[#102a43]">
            Renovación de superficies
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-[#687078]">
            Renovación de superficies para actualizar el aspecto y acabado
            de diferentes estancias.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- =====================================================
       VENTAJAS
       ===================================================== -->

  <section class="bg-[#e8ded0] py-16 md:py-20">

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">

        <div>

          <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#b58a3a]">
            STARLYN REFORMAS
          </span>

          <h2 class="mt-3 text-3xl font-black tracking-tight text-[#102a43] sm:text-4xl">
            Un acabado pensado para cada espacio
          </h2>

          <p class="mt-5 leading-relaxed text-[#687078]">
            El alicatado forma parte importante del resultado visual y
            funcional de una reforma. Por eso cada trabajo debe adaptarse
            a las características de la superficie y del espacio.
          </p>

          <a
            href="#contacto"
            class="mt-7 inline-flex items-center gap-2 font-bold text-[#102a43] hover:text-[#b58a3a]"
          >
            Cuéntanos tu proyecto

            <ArrowRight
              class="h-5 w-5"
              strokeWidth={1.8}
            />
          </a>

        </div>


        <div class="grid gap-4 sm:grid-cols-2">


          <!-- DETALLE -->

          <div class="rounded-2xl border border-white/60 bg-white/70 p-6">

            <ShieldCheck
              class="h-9 w-9 text-[#b58a3a]"
              strokeWidth={1.3}
            />

            <h3 class="mt-5 font-bold text-[#102a43]">
              Trabajo cuidado
            </h3>

            <p class="mt-2 text-sm leading-relaxed text-[#687078]">
              Atención a la preparación, colocación y acabado de cada trabajo.
            </p>

          </div>


          <!-- PRECISIÓN -->

          <div class="rounded-2xl border border-white/60 bg-white/70 p-6">

            <Ruler
              class="h-9 w-9 text-[#b58a3a]"
              strokeWidth={1.3}
            />

            <h3 class="mt-5 font-bold text-[#102a43]">
              Precisión
            </h3>

            <p class="mt-2 text-sm leading-relaxed text-[#687078]">
              Una correcta planificación es fundamental para conseguir un
              resultado uniforme.
            </p>

          </div>


          <!-- VIVIENDAS -->

          <div class="rounded-2xl border border-white/60 bg-white/70 p-6">

            <Home
              class="h-9 w-9 text-[#b58a3a]"
              strokeWidth={1.3}
            />

            <h3 class="mt-5 font-bold text-[#102a43]">
              Viviendas y espacios
            </h3>

            <p class="mt-2 text-sm leading-relaxed text-[#687078]">
              Soluciones para diferentes estancias dentro de proyectos de
              reforma.
            </p>

          </div>


          <!-- REFORMA -->

          <div class="rounded-2xl border border-white/60 bg-white/70 p-6">

            <Wrench
              class="h-9 w-9 text-[#b58a3a]"
              strokeWidth={1.3}
            />

            <h3 class="mt-5 font-bold text-[#102a43]">
              Integrado en la reforma
            </h3>

            <p class="mt-2 text-sm leading-relaxed text-[#687078]">
              El alicatado puede formar parte de reformas de baños, cocinas
              y otros proyectos.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       TIPOS DE PROYECTO
       ===================================================== -->

  <section class="bg-white py-16 md:py-20">

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <div class="mx-auto max-w-2xl text-center">

        <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#b58a3a]">
          Aplicaciones
        </span>

        <h2 class="mt-3 text-3xl font-black text-[#102a43] sm:text-4xl">
          Diferentes espacios, una solución adaptada
        </h2>

        <p class="mt-4 leading-relaxed text-[#687078]">
          Podemos integrar los trabajos de alicatado dentro de diferentes
          proyectos de reforma.
        </p>

      </div>


      <div class="mt-12 grid gap-6 md:grid-cols-3">


        <article class="rounded-2xl border border-[#e8ded0] bg-[#f7f4ee] p-7">

          <Bath
            class="h-10 w-10 text-[#b58a3a]"
            strokeWidth={1.25}
          />

          <h3 class="mt-5 text-xl font-bold text-[#102a43]">
            Baños
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-[#687078]">
            Revestimientos y renovación de superficies dentro de reformas
            de baños.
          </p>

        </article>


        <article class="rounded-2xl border border-[#e8ded0] bg-[#f7f4ee] p-7">

          <Utensils
            class="h-10 w-10 text-[#b58a3a]"
            strokeWidth={1.25}
          />

          <h3 class="mt-5 text-xl font-bold text-[#102a43]">
            Cocinas
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-[#687078]">
            Soluciones de revestimiento para actualizar y transformar
            diferentes zonas de la cocina.
          </p>

        </article>


        <article class="rounded-2xl border border-[#e8ded0] bg-[#f7f4ee] p-7">

          <SquareStack
            class="h-10 w-10 text-[#b58a3a]"
            strokeWidth={1.25}
          />

          <h3 class="mt-5 text-xl font-bold text-[#102a43]">
            Otros espacios
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-[#687078]">
            También podemos valorar trabajos de revestimiento en otros
            espacios interiores según las necesidades del proyecto.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- =====================================================
       PROCESO
       ===================================================== -->

  <section class="bg-[#f7f4ee] py-16 md:py-20">

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <div class="mx-auto max-w-2xl text-center">

        <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#b58a3a]">
          Proceso
        </span>

        <h2 class="mt-3 text-3xl font-black text-[#102a43] sm:text-4xl">
          Así comenzamos tu proyecto
        </h2>

      </div>


      <div class="mt-12 grid gap-6 md:grid-cols-4">


        <div class="rounded-2xl border border-[#e8ded0] bg-white p-6">

          <span class="text-4xl font-black text-[#d2b06a]/50">
            01
          </span>

          <ClipboardCheck
            class="mt-5 h-8 w-8 text-[#b58a3a]"
            strokeWidth={1.3}
          />

          <h3 class="mt-4 font-bold text-[#102a43]">
            Contacto
          </h3>

          <p class="mt-2 text-sm leading-relaxed text-[#687078]">
            Nos explicas qué necesitas y las características del espacio.
          </p>

        </div>


        <div class="rounded-2xl border border-[#e8ded0] bg-white p-6">

          <span class="text-4xl font-black text-[#d2b06a]/50">
            02
          </span>

          <MapPin
            class="mt-5 h-8 w-8 text-[#b58a3a]"
            strokeWidth={1.3}
          />

          <h3 class="mt-4 font-bold text-[#102a43]">
            Valoración
          </h3>

          <p class="mt-2 text-sm leading-relaxed text-[#687078]">
            Analizamos el espacio y el trabajo que necesita el proyecto.
          </p>

        </div>


        <div class="rounded-2xl border border-[#e8ded0] bg-white p-6">

          <span class="text-4xl font-black text-[#d2b06a]/50">
            03
          </span>

          <Ruler
            class="mt-5 h-8 w-8 text-[#b58a3a]"
            strokeWidth={1.3}
          />

          <h3 class="mt-4 font-bold text-[#102a43]">
            Propuesta
          </h3>

          <p class="mt-2 text-sm leading-relaxed text-[#687078]">
            Definimos contigo la solución más adecuada para el proyecto.
          </p>

        </div>


        <div class="rounded-2xl border border-[#e8ded0] bg-white p-6">

          <span class="text-4xl font-black text-[#d2b06a]/50">
            04
          </span>

          <Wrench
            class="mt-5 h-8 w-8 text-[#b58a3a]"
            strokeWidth={1.3}
          />

          <h3 class="mt-4 font-bold text-[#102a43]">
            Ejecución
          </h3>

          <p class="mt-2 text-sm leading-relaxed text-[#687078]">
            Ejecutamos el trabajo siguiendo la solución acordada.
          </p>

        </div>

      </div>

    </div>

  </section>

<!-- =====================================================
     TRABAJOS REALIZADOS
====================================================== -->
<section
  id="proyectos"
  class="border-y border-[#e8ded0] bg-[#173b57] py-20 md:py-28"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <div class="max-w-3xl">
      <span
        class="text-xs font-bold uppercase tracking-[0.18em] text-[#d2b06a]"
      >
        Trabajos realizados
      </span>

      <h2
        class="mt-3 text-3xl font-black tracking-tight text-white md:text-5xl"
      >
        Alicatados realizados por STARLYN REFORMAS.
      </h2>

      <p
        class="mt-5 text-base leading-relaxed text-[#c9d4db] md:text-lg"
      >
        Mostramos aquí trabajos reales de alicatado y revestimientos
        realizados por STARLYN REFORMAS.
      </p>
    </div>

    <div class="mt-12">
      {
        trabajosAlicatados.length > 0 ? (
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {trabajosAlicatados.map((proyecto) => (
              <article
                class="group overflow-hidden rounded-2xl border border-white/10 bg-[#102a43] shadow-[0_18px_45px_rgba(0,0,0,0.16)]"
              >
                <div class="relative aspect-[4/3] overflow-hidden bg-[#102a43]">
                  <img
                    src={proyecto.imagen}
                    alt={
                      proyecto.titulo ||
                      "Trabajo de alicatado realizado por STARLYN REFORMAS"
                    }
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </div>

                <div class="p-5">
                  <span
                    class="text-xs font-bold uppercase tracking-[0.16em] text-[#d2b06a]"
                  >
                    {proyecto.categoria}
                  </span>

                  <h3 class="mt-2 text-lg font-bold text-white">
                    {proyecto.titulo}
                  </h3>

                  {
                    proyecto.descripcion && (
                      <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-[#c9d4db]">
                        {proyecto.descripcion}
                      </p>
                    )
                  }
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div
            class="rounded-2xl border border-white/10 bg-[#102a43] px-6 py-12 text-center shadow-[0_18px_45px_rgba(0,0,0,0.12)]"
          >
            <Grid3X3
              class="mx-auto h-10 w-10 text-[#d2b06a]"
              strokeWidth={1.35}
            />

            <h3 class="mt-5 text-xl font-bold text-white">
              Próximamente, nuevos trabajos realizados
            </h3>

            <p
              class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-[#c9d4db]"
            >
              Estamos preparando nuestra selección de trabajos de
              alicatado realizados por STARLYN REFORMAS.
            </p>
          </div>
        )
      }
    </div>

  </div>
</section>

  <!-- =====================================================
       CONTACTO
       ===================================================== -->

  <section id="contacto" class="bg-[#102a43] py-16 text-white md:py-20">

    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">

        <div>

          <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#d2b06a]">
            Hablemos de tu proyecto
          </span>

          <h2 class="mt-3 text-3xl font-black sm:text-4xl">
            ¿Necesitas un trabajo de alicatado?
          </h2>

          <p class="mt-5 leading-relaxed text-[#dbe4ea]">
            Cuéntanos qué necesitas y la zona donde se encuentra el proyecto.
            Podemos valorar contigo el trabajo que necesitas realizar.
          </p>

          <div class="mt-7 space-y-4">

            <a
              href="/#contacto"
              class="flex items-center gap-3 text-[#dbe4ea] hover:text-[#d2b06a]"
            >
              <Phone
                class="h-5 w-5 text-[#d2b06a]"
                strokeWidth={1.6}
              />

              Contactar con STARLYN REFORMAS
            </a>

            <div class="flex items-center gap-3 text-[#dbe4ea]">

              <MapPin
                class="h-5 w-5 text-[#d2b06a]"
                strokeWidth={1.6}
              />

              Zaragoza y alrededores

            </div>

          </div>

        </div>


        <div class="rounded-2xl border border-white/10 bg-white/5 p-6 shadow-2xl sm:p-8">

          <h3 class="text-xl font-bold text-[#d2b06a]">
            Solicita información
          </h3>

          <form
            action="https://formspree.io/f/tu-endpoint-aqui"
            method="POST"
            class="mt-6 space-y-4"
          >

            <div class="grid gap-4 sm:grid-cols-2">

              <input
                type="text"
                name="nombre"
                placeholder="Nombre completo *"
                required
                class="w-full rounded-xl border border-white/10 bg-[#173b57] px-4 py-3 text-white placeholder:text-[#b8c6cf] outline-none focus:border-[#d2b06a]"
              />

              <input
                type="tel"
                name="telefono"
                placeholder="Teléfono de contacto *"
                required
                class="w-full rounded-xl border border-white/10 bg-[#173b57] px-4 py-3 text-white placeholder:text-[#b8c6cf] outline-none focus:border-[#d2b06a]"
              />

            </div>

<div
  class="relative z-50 overflow-visible"
  id="autocomplete-wrapper"
>
  <input
    type="text"
    id="barrio-input"
    name="barrio"
    autocomplete="off"
    placeholder="Zona o barrio donde está el proyecto"
    class="w-full rounded-xl border border-white/10 bg-[#173b57] px-4 py-3 text-white placeholder:text-[#b8c6cf] outline-none focus:border-[#d2b06a]"
  />

