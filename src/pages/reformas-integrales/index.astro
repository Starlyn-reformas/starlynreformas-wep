		</div>
	</section>

	<!-- =====================================================
	     PROCESO
	====================================================== -->
	<section class="bg-[#f7f4ee] py-20 md:py-28">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-3xl text-center">
				<span
					class="text-xs font-bold uppercase tracking-[0.18em] text-[#b58a3a]"
				>
					El proceso
				</span>

				<h2
					class="mt-3 text-3xl font-black tracking-tight text-[#102a43] md:text-5xl"
				>
					Una reforma integral necesita planificación.
				</h2>

				<p
					class="mt-5 text-base leading-relaxed text-[#687078] md:text-lg"
				>
					Antes de empezar una reforma completa es importante
					entender la vivienda, sus necesidades y los trabajos
					que requiere.
				</p>
			</div>

			<div
				class="relative mx-auto mt-14 grid max-w-5xl gap-5 md:grid-cols-4"
			>
				<div
					class="hidden h-px bg-[#d2b06a]/40 md:absolute md:left-[12%] md:right-[12%] md:top-10 md:block"
				></div>

				<div
					class="relative rounded-2xl border border-[#e2d8cb] bg-white p-6 text-center"
				>
					<div
						class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#102a43] text-xl font-black text-[#d2b06a]"
					>
						01
					</div>

					<h3
						class="mt-6 font-bold text-[#102a43]"
					>
						Conocemos la vivienda
					</h3>

					<p
						class="mt-2 text-sm leading-relaxed text-[#687078]"
					>
						Analizamos el espacio y las necesidades del proyecto.
					</p>
				</div>

				<div
					class="relative rounded-2xl border border-[#e2d8cb] bg-white p-6 text-center"
				>
					<div
						class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#173b57] text-xl font-black text-[#d2b06a]"
					>
						02
					</div>

					<h3
						class="mt-6 font-bold text-[#102a43]"
					>
						Definimos los trabajos
					</h3>

					<p
						class="mt-2 text-sm leading-relaxed text-[#687078]"
					>
						Determinamos qué actuaciones necesita la vivienda.
					</p>
				</div>

				<div
					class="relative rounded-2xl border border-[#e2d8cb] bg-white p-6 text-center"
				>
					<div
						class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#102a43] text-xl font-black text-[#d2b06a]"
					>
						03
					</div>

					<h3
						class="mt-6 font-bold text-[#102a43]"
					>
						Coordinamos la reforma
					</h3>

					<p
						class="mt-2 text-sm leading-relaxed text-[#687078]"
					>
						Integramos los diferentes trabajos del proyecto.
					</p>
				</div>

				<div
					class="relative rounded-2xl border border-[#e2d8cb] bg-white p-6 text-center"
				>
					<div
						class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#173b57] text-xl font-black text-[#d2b06a]"
					>
						04
					</div>

					<h3
						class="mt-6 font-bold text-[#102a43]"
					>
						Completamos los acabados
					</h3>

					<p
						class="mt-2 text-sm leading-relaxed text-[#687078]"
					>
						Finalizamos los trabajos previstos en la reforma.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- =====================================================
     PROYECTOS
====================================================== -->
<section
        id="proyectos"
        class="border-y border-[#e8ded0] bg-[#173b57] py-20 md:py-28"
>
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="max-w-3xl">
                        <span
                                class="text-xs font-bold uppercase tracking-[0.18em] text-[#d2b06a]"
                        >
                                Proyectos
                        </span>

                        <h2
                                class="mt-3 text-3xl font-black tracking-tight text-white md:text-5xl"
                        >
                                El resultado empieza con una buena planificación.
                        </h2>

                        <p
                                class="mt-5 text-base leading-relaxed text-[#c9d4db] md:text-lg"
                        >
                                Podemos mostrar aquí diferentes trabajos reales de
                                reformas integrales realizados por STARLYN REFORMAS.
                        </p>
                </div>

                <div class="mt-12">
                        {
                                trabajosReformas.length > 0 ? (
                                        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                                                {trabajosReformas.map((proyecto) => (
                                                        <article
                                                                class="group overflow-hidden rounded-2xl border border-white/10 bg-[#102a43] shadow-[0_18px_45px_rgba(0,0,0,0.16)]"
                                                        >
                                                                <div class="relative aspect-[4/3] overflow-hidden bg-[#102a43]">
                                                                        <img
                                                                                src={proyecto.imagen}
                                                                                alt={
                                                                                        proyecto.titulo ||
                                                                                        "Trabajo de reforma integral realizado por STARLYN REFORMAS"
                                                                                }
                                                                                class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
                                                                                loading="lazy"
                                                                        />
                                                                </div>

                                                                <div class="p-5">
                                                                        <span
                                                                                class="text-xs font-bold uppercase tracking-[0.16em] text-[#d2b06a]"
                                                                        >
                                                                                {proyecto.categoria}
                                                                        </span>

                                                                        <h3
                                                                                class="mt-2 text-lg font-bold text-white"
                                                                        >
                                                                                {proyecto.titulo}
                                                                        </h3>

                                                                        {
                                                                                proyecto.descripcion && (
                                                                                        <p
                                                                                                class="mt-2 line-clamp-2 text-sm leading-relaxed text-[#c9d4db]"
                                                                                        >
                                                                                                {proyecto.descripcion}
                                                                                        </p>
                                                                                )
                                                                        }
                                                                </div>
                                                        </article>
                                                ))}
                                        </div>
                                ) : (
                                        <div class="rounded-2xl border border-white/10 bg-[#102a43] px-6 py-12 text-center shadow-[0_18px_45px_rgba(0,0,0,0.12)]">
                                                <Sparkles
                                                        class="mx-auto h-10 w-10 text-[#d2b06a]"
                                                        stroke-width="1.35"
                                                />

                                                <h3
                                                        class="mt-5 text-xl font-bold text-white"
                                                >
                                                        Próximamente, nuevos trabajos realizados
                                                </h3>

                                                <p
                                                        class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-[#c9d4db]"
                                                >
                                                        Estamos preparando nuestra selección de
                                                        proyectos de reformas integrales realizados
                                                        por STARLYN REFORMAS.
                                                </p>
                                        </div>
                                )
                        }
                </div>
        </div>
</section>

	<!-- =====================================================
	     CONTACTO / CONVERSIÓN
	====================================================== -->
	<section
		id="contacto"
		class="relative overflow-visible bg-[#102a43] py-20 text-white md:py-28"
	>
		<div
			class="pointer-events-none absolute -left-32 bottom-0 h-80 w-80 rounded-full bg-[#b58a3a]/10 blur-3xl"
		></div>

		<div
			class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
		>
			<div
				class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start"
			>
				<!-- TEXTO -->
				<div>
					<span
						class="text-xs font-bold uppercase tracking-[0.18em] text-[#d2b06a]"
					>
						Da el primer paso
					</span>

					<h2
						class="mt-3 text-3xl font-black tracking-tight md:text-5xl"
					>
						Cuéntanos qué quieres transformar.
					</h2>

					<p
						class="mt-5 max-w-xl text-base leading-relaxed text-[#c9d4db] md:text-lg"
					>
						Indícanos qué tipo de reforma estás planteando,
						dónde se encuentra la vivienda y qué necesitas
						cambiar.
					</p>

					<div class="mt-9 space-y-5">
						<div class="flex items-start gap-4">
							<div
								class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/5 text-[#d2b06a]"
							>
								<MapPin
									class="h-5 w-5"
									stroke-width="1.5"
								/>
							</div>

							<div>
								<h3 class="font-bold text-white">
									Zaragoza y alrededores
								</h3>

								<p
									class="mt-1 text-sm leading-relaxed text-[#9eafb9]"
								>
									Indícanos la ubicación del proyecto
									para conocer mejor tu caso.
								</p>
							</div>
						</div>

						<div class="flex items-start gap-4">
							<div
								class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/5 text-[#d2b06a]"
							>
								<ClipboardCheck
									class="h-5 w-5"
									stroke-width="1.5"
								/>
							</div>

							<div>
								<h3 class="font-bold text-white">
									Estudiamos el proyecto
								</h3>

								<p
									class="mt-1 text-sm leading-relaxed text-[#9eafb9]"
								>
									Cuantos más detalles nos proporciones,
									mejor podremos entender lo que necesitas.
								</p>
							</div>
						</div>

						<div class="flex items-start gap-4">
							<div
								class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/5 text-[#d2b06a]"
							>
								<Phone
									class="h-5 w-5"
									stroke-width="1.5"
								/>
							</div>

							<div>
								<h3 class="font-bold text-white">
									También puedes llamarnos
								</h3>

								<a
									href="tel:+34614783004"
									class="mt-1 block text-sm text-[#d2b06a] hover:text-[#e0c384]"
								>
									614 78 30 04
								</a>
							</div>
						</div>
					</div>
				</div>

				<!-- FORMULARIO -->
				<form
					action="https://formspree.io/f/tu-endpoint-aqui"
					method="POST"
					class="relative z-20 rounded-3xl border border-white/10 bg-[#173b57] p-6 shadow-[0_25px_70px_rgba(0,0,0,0.25)] sm:p-8 md:p-10"
				>
					<div class="mb-7">
						<h3
							class="text-2xl font-black text-white"
						>
							Cuéntanos tu proyecto
						</h3>

						<p
							class="mt-2 text-sm leading-relaxed text-[#9eafb9]"
						>
							Los datos marcados con * son obligatorios.
						</p>
					</div>

					<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
						<div>
							<label
								for="nombre"
								class="mb-2 block text-xs font-bold uppercase tracking-wider text-[#d8e0e5]"
							>
								Nombre *
							</label>

							<input
								type="text"
								id="nombre"
								name="nombre"
								placeholder="Nombre completo"
								required
								class="w-full rounded-xl border border-white/10 bg-[#102a43] px-4 py-3.5 text-white placeholder-[#71808a] outline-none transition focus:border-[#d2b06a]"
							/>
						</div>

						<div>
							<label
								for="telefono"
								class="mb-2 block text-xs font-bold uppercase tracking-wider text-[#d8e0e5]"
							>
