							class="w-full resize-none rounded-xl border border-white/10 bg-[#102a43] px-4 py-3.5 text-white placeholder-[#71808a] outline-none transition focus:border-[#d2b06a]"
						></textarea>
					</div>

					<button
						type="submit"
						class="group mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-[#d2b06a] px-6 py-4 text-base font-black text-[#102a43] transition hover:bg-[#e0c384]"
					>
						<ClipboardCheck
							class="h-5 w-5"
							stroke-width="1.8"
						/>

						Solicitar presupuesto integral

						<ArrowRight
							class="h-5 w-5 transition-transform group-hover:translate-x-1"
							stroke-width="1.8"
						/>
					</button>

					<a
						href="https://wa.me/34614783004?text=Hola,%20quiero%20información%20sobre%20una%20reforma%20integral"
						target="_blank"
						rel="noopener noreferrer"
						class="mt-3 flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-white/[0.08]"
					>
						<MessageCircle
							class="h-5 w-5 text-[#d2b06a]"
							stroke-width="1.6"
						/>

						Si prefieres, escríbenos por WhatsApp
					</a>
				</form>
			</div>
		</div>
	</section>
