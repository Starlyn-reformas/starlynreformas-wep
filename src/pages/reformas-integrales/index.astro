---
import Layout from "../../layouts/Layout.astro";
import { createClient } from "@supabase/supabase-js";


import {
	House,
	Ruler,
	Hammer,
	BrickWall,
	Droplets,
	Plug,
	PanelTop,
	Grid3X3,
	ClipboardCheck,
	ArrowRight,
	Phone,
	MessageCircle,
	MapPin,
	Check,
	Sparkles,
	Home,
	Layers3,
} from "@lucide/astro";
const supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY
);

const {
        data: proyectosReformas,
        error: proyectosReformasError,
} = await supabase
        .from("proyectos")
        .select(
                "id, titulo, descripcion, categoria, imagen, orden, created_at"
        )
        .eq("categoria", "Reformas integrales")
        .eq("publicado", true)
        .not("imagen", "is", null)
        .order("orden", { ascending: true })
        .order("created_at", { ascending: false })
        .limit(6);

const trabajosReformas = proyectosReformas ?? [];

if (proyectosReformasError) {
        console.error(
                "Error cargando proyectos de reformas integrales:",
                proyectosReformasError
        );
}
---

<Layout
	title="Reformas Integrales en Zaragoza | Pisos y Viviendas | STARLYN REFORMAS"
	description="Reformas integrales de pisos y viviendas en Zaragoza. Coordinamos demolición, distribución, pladur, alicatados, fontanería, electricidad y acabados."
>
	<!-- =====================================================
	     HERO
	====================================================== -->
	<section
		class="relative overflow-hidden bg-[#102a43] text-white"
	>
		<!-- Decoración -->
		<div
			class="pointer-events-none absolute -right-40 -top-40 h-[32rem] w-[32rem] rounded-full bg-[#b58a3a]/10 blur-3xl"
		></div>

		<div
			class="pointer-events-none absolute -bottom-48 -left-40 h-[30rem] w-[30rem] rounded-full bg-[#294d67]/30 blur-3xl"
		></div>

		<div
			class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28 lg:px-8 lg:py-32"
		>
			<div
				class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]"
			>
				<!-- TEXTO PRINCIPAL -->
				<div class="max-w-3xl">
					<div
						class="mb-7 inline-flex items-center gap-2 rounded-full border border-[#d2b06a]/30 bg-white/[0.04] px-4 py-2"
					>
						<House
							class="h-4 w-4 text-[#d2b06a]"
							stroke-width="1.5"
						/>

						<span
							class="text-xs font-semibold uppercase tracking-[0.16em] text-[#e7d5ae]"
						>
							Reformas integrales · Zaragoza y alrededores
						</span>
					</div>

					<h1
						class="text-4xl font-black leading-[1.06] tracking-tight sm:text-5xl md:text-6xl lg:text-7xl"
					>
						Transformamos tu vivienda
						<span class="block text-[#d2b06a]">
							de principio a fin.
						</span>
					</h1>

					<p
						class="mt-7 max-w-2xl text-base leading-relaxed text-[#d8e0e5] sm:text-lg md:text-xl"
					>
						Reformas integrales de pisos y viviendas,
						coordinando los diferentes trabajos necesarios para
						transformar el espacio y adaptarlo a tu forma de
						vivir.
					</p>

					<!-- CTA -->
					<div class="mt-9 flex flex-col gap-3 sm:flex-row">
						<a
							href="#contacto"
							class="group inline-flex items-center justify-center gap-2 rounded-xl bg-[#d2b06a] px-7 py-4 text-base font-bold text-[#102a43] shadow-lg shadow-black/10 transition hover:bg-[#e0c384]"
						>
							Solicitar presupuesto

							<ArrowRight
								class="h-5 w-5 transition-transform group-hover:translate-x-1"
								stroke-width="1.8"
							/>
						</a>

						<a
							href="tel:+34614783004"
							class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/[0.05] px-7 py-4 text-base font-semibold text-white transition hover:border-white/30 hover:bg-white/[0.1]"
						>
							<Phone
								class="h-5 w-5 text-[#d2b06a]"
								stroke-width="1.7"
							/>

							Hablar con STARLYN
						</a>
					</div>

					<!-- DATOS -->
					<div
						class="mt-10 flex flex-wrap gap-x-7 gap-y-3 border-t border-white/10 pt-7 text-sm text-[#c6d0d7]"
					>
						<div class="flex items-center gap-2">
							<Check
								class="h-4 w-4 text-[#d2b06a]"
								stroke-width="2"
							/>
							12+ años de experiencia
						</div>

						<div class="flex items-center gap-2">
							<Check
								class="h-4 w-4 text-[#d2b06a]"
								stroke-width="2"
							/>
							Proyecto global
						</div>

						<div class="flex items-center gap-2">
							<Check
								class="h-4 w-4 text-[#d2b06a]"
								stroke-width="2"
							/>
							Zaragoza y alrededores
						</div>
					</div>
				</div>

				<!-- BLOQUE VISUAL -->
				<div class="relative">
					<div
						class="relative overflow-hidden rounded-3xl border border-white/10 bg-[#173b57] shadow-[0_30px_80px_rgba(0,0,0,0.3)]"
					>
						<img
							src="/trabajos/reforma-integral1.jpg"
							alt="Reforma integral de vivienda realizada por STARLYN REFORMAS"
							class="aspect-[4/3] h-full w-full object-cover"
							onerror="this.src='https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=85'"
						/>

						<div
							class="absolute inset-0 bg-gradient-to-t from-[#102a43]/95 via-[#102a43]/10 to-transparent"
						></div>

						<div
							class="absolute bottom-0 left-0 right-0 p-6 sm:p-8"
						>
							<span
								class="text-xs font-bold uppercase tracking-[0.16em] text-[#d2b06a]"
							>
								Reforma integral
							</span>

							<h2
								class="mt-2 max-w-lg text-2xl font-bold text-white sm:text-3xl"
							>
								Un solo proyecto para transformar toda la vivienda.
							</h2>
						</div>
					</div>

					<div
						class="pointer-events-none absolute -bottom-5 -right-5 h-24 w-24 rounded-2xl border border-[#d2b06a]/30"
					></div>
				</div>
			</div>
		</div>
	</section>

	<!-- =====================================================
	     QUÉ ES UNA REFORMA INTEGRAL
	====================================================== -->
	<section class="bg-[#f7f4ee] py-20 md:py-28">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div
				class="grid items-center gap-14 lg:grid-cols-[0.9fr_1.1fr]"
			>
				<div>
					<span
						class="text-xs font-bold uppercase tracking-[0.18em] text-[#b58a3a]"
					>
						Reforma integral
					</span>

					<h2
						class="mt-3 text-3xl font-black leading-tight tracking-tight text-[#102a43] md:text-5xl"
					>
						No se trata solo de cambiar una habitación.
					</h2>

					<p
						class="mt-6 text-base leading-relaxed text-[#687078] md:text-lg"
					>
						Una reforma integral permite replantear diferentes
						espacios de una vivienda y coordinar los trabajos
						necesarios para conseguir un resultado conjunto.
					</p>

					<p
						class="mt-4 text-base leading-relaxed text-[#687078]"
					>
						Desde la distribución y la tabiquería hasta las
						instalaciones, revestimientos y acabados finales.
					</p>

					<a
						href="#contacto"
						class="group mt-8 inline-flex items-center gap-2 text-sm font-bold text-[#b58a3a]"
					>
						Quiero estudiar mi vivienda

						<ArrowRight
							class="h-4 w-4 transition-transform group-hover:translate-x-1"
							stroke-width="1.8"
						/>
					</a>
				</div>

				<!-- BLOQUES -->
				<div class="grid gap-4 sm:grid-cols-2">
					<div
						class="rounded-2xl border border-[#e2d8cb] bg-white p-7 shadow-[0_8px_30px_rgba(16,42,67,0.04)]"
					>
						<div
							class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#102a43] text-[#d2b06a]"
						>
							<Layers3
								class="h-7 w-7"
								stroke-width="1.25"
							/>
						</div>

						<h3
							class="mt-6 text-lg font-bold text-[#102a43]"
						>
							Distribución
						</h3>

						<p
							class="mt-2 text-sm leading-relaxed text-[#687078]"
						>
							Replanteamiento de espacios y soluciones de
							distribución.
						</p>
					</div>

					<div
						class="rounded-2xl border border-[#e2d8cb] bg-white p-7 shadow-[0_8px_30px_rgba(16,42,67,0.04)]"
					>
						<div
							class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#173b57] text-[#d2b06a]"
						>
							<PanelTop
								class="h-7 w-7"
								stroke-width="1.25"
							/>
						</div>

						<h3
							class="mt-6 text-lg font-bold text-[#102a43]"
						>
							Tabiquería y Pladur
						</h3>

						<p
							class="mt-2 text-sm leading-relaxed text-[#687078]"
						>
							Soluciones para modificar o crear nuevos
							espacios interiores.
						</p>
					</div>

					<div
						class="rounded-2xl border border-[#e2d8cb] bg-white p-7 shadow-[0_8px_30px_rgba(16,42,67,0.04)]"
					>
						<div
							class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#173b57] text-[#d2b06a]"
						>
							<Droplets
								class="h-7 w-7"
								stroke-width="1.25"
							/>
						</div>

						<h3
							class="mt-6 text-lg font-bold text-[#102a43]"
						>
							Fontanería
						</h3>

						<p
							class="mt-2 text-sm leading-relaxed text-[#687078]"
						>
							Adaptación y renovación de las instalaciones de
							agua.
						</p>
					</div>

					<div
						class="rounded-2xl border border-[#e2d8cb] bg-white p-7 shadow-[0_8px_30px_rgba(16,42,67,0.04)]"
					>
						<div
							class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#102a43] text-[#d2b06a]"
						>
							<Plug
								class="h-7 w-7"
								stroke-width="1.25"
							/>
						</div>

						<h3
							class="mt-6 text-lg font-bold text-[#102a43]"
						>
							Electricidad
						</h3>

						<p
							class="mt-2 text-sm leading-relaxed text-[#687078]"
						>
							Adaptación de instalaciones y puntos
							eléctricos según las necesidades del proyecto.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- =====================================================
	     SERVICIOS INTEGRADOS
	====================================================== -->
	<section
		class="border-y border-[#e8ded0] bg-[#e8ded0]/45 py-20 md:py-28"
	>
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="max-w-3xl">
				<span
					class="text-xs font-bold uppercase tracking-[0.18em] text-[#b58a3a]"
				>
					Qué podemos integrar
				</span>

				<h2
					class="mt-3 text-3xl font-black tracking-tight text-[#102a43] md:text-5xl"
				>
					Los diferentes trabajos forman parte de un mismo proyecto.
				</h2>

				<p
					class="mt-5 text-base leading-relaxed text-[#687078] md:text-lg"
				>
					Una reforma integral puede combinar diferentes
					servicios según las características y necesidades de
					cada vivienda.
				</p>
			</div>

			<div
				class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4"
			>
				<div
					class="rounded-2xl border border-[#dfd3c4] bg-[#f7f4ee] p-6"
				>
					<Hammer
						class="h-8 w-8 text-[#b58a3a]"
						stroke-width="1.35"
					/>

					<h3
						class="mt-5 font-bold text-[#102a43]"
					>
						Demoliciones
					</h3>

					<p class="mt-2 text-sm text-[#687078]">
						Preparación del espacio para la reforma.
					</p>
				</div>

				<div
					class="rounded-2xl border border-[#dfd3c4] bg-[#f7f4ee] p-6"
				>
					<PanelTop
						class="h-8 w-8 text-[#b58a3a]"
						stroke-width="1.35"
					/>

					<h3
						class="mt-5 font-bold text-[#102a43]"
					>
						Pladur
					</h3>

					<p class="mt-2 text-sm text-[#687078]">
						Tabiquería y soluciones en construcción ligera.
					</p>
				</div>

				<div
					class="rounded-2xl border border-[#dfd3c4] bg-[#f7f4ee] p-6"
				>
					<BrickWall
						class="h-8 w-8 text-[#b58a3a]"
						stroke-width="1.35"
					/>

					<h3
						class="mt-5 font-bold text-[#102a43]"
					>
						Alicatados
					</h3>

					<p class="mt-2 text-sm text-[#687078]">
						Revestimientos y acabados de paredes.
					</p>
				</div>

				<div
					class="rounded-2xl border border-[#dfd3c4] bg-[#f7f4ee] p-6"
				>
					<Grid3X3
						class="h-8 w-8 text-[#b58a3a]"
						stroke-width="1.35"
					/>

					<h3
						class="mt-5 font-bold text-[#102a43]"
					>
						Solados
					</h3>

					<p class="mt-2 text-sm text-[#687078]">
						Revestimientos y pavimentos.
					</p>
				</div>

				<div
					class="rounded-2xl border border-[#dfd3c4] bg-[#f7f4ee] p-6"
				>
					<Droplets
						class="h-8 w-8 text-[#b58a3a]"
						stroke-width="1.35"
					/>

					<h3
						class="mt-5 font-bold text-[#102a43]"
					>
						Fontanería
					</h3>

					<p class="mt-2 text-sm text-[#687078]">
						Instalaciones y adaptación de agua.
					</p>
				</div>

				<div
					class="rounded-2xl border border-[#dfd3c4] bg-[#f7f4ee] p-6"
				>
					<Plug
						class="h-8 w-8 text-[#b58a3a]"
						stroke-width="1.35"
					/>

					<h3
						class="mt-5 font-bold text-[#102a43]"
					>
						Electricidad
					</h3>

					<p class="mt-2 text-sm text-[#687078]">
						Instalaciones y puntos eléctricos.
					</p>
				</div>

				<div
					class="rounded-2xl border border-[#dfd3c4] bg-[#f7f4ee] p-6"
				>
					<Home
						class="h-8 w-8 text-[#b58a3a]"
						stroke-width="1.35"
					/>

					<h3
						class="mt-5 font-bold text-[#102a43]"
					>
						Cocinas
					</h3>

					<p class="mt-2 text-sm text-[#687078]">
						Reforma y renovación del espacio de cocina.
					</p>
				</div>

				<div
					class="rounded-2xl border border-[#dfd3c4] bg-[#f7f4ee] p-6"
				>
					<Sparkles
						class="h-8 w-8 text-[#b58a3a]"
						stroke-width="1.35"
					/>

					<h3
						class="mt-5 font-bold text-[#102a43]"
					>
						Acabados
					</h3>

					<p class="mt-2 text-sm text-[#687078]">
						Detalles finales para completar la reforma.
					</p>
