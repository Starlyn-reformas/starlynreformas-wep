	<!-- =====================================================
	     AUTOCOMPLETADO
	====================================================== -->
	<script is:inline>
		(function () {
			function initAutocomplete() {
				var input = document.getElementById("barrio-input");
				var resultsList =
					document.getElementById("direccion-results");
				var wrapper =
					document.getElementById("autocomplete-wrapper");

				if (!input || !resultsList || !wrapper) return;

				var zonasZaragoza = [
					"Actur",
					"Centro / Paseo Sagasta",
					"Delicias",
					"Romareda",
					"San José",
					"Las Fuentes",
					"Santa Isabel",
					"Valdespartera",
					"Montecanal",
					"Miralbueno",
					"El Oliver",
					"Torrero / La Paz",
					"Almozara",
					"Calle Antonio Bravo, Zaragoza",
					"Calle Antonio Cánovas, Zaragoza",
					"Paseo Independencia, Zaragoza",
					"Gran Vía, Zaragoza",
					"Calle Alfonso I, Zaragoza",
					"Calle Don Jaime I, Zaragoza",
					"Avenida de Madrid, Zaragoza",
					"Avenida Navarra, Zaragoza",
				];

				function filterAndShow(query) {
					var cleanQuery = query.toLowerCase().trim();

					resultsList.innerHTML = "";

					if (!cleanQuery) {
						resultsList.classList.add("hidden");
						return;
					}

					var matches = zonasZaragoza.filter(function (item) {
						return (
							item.toLowerCase().indexOf(cleanQuery) !== -1
						);
					});

					if (matches.length > 0) {
						matches.forEach(function (zona) {
							var li = document.createElement("li");

							li.className =
								"cursor-pointer px-4 py-3 text-sm text-[#d8e0e5] transition hover:bg-[#173b57] hover:text-white";

							li.setAttribute("role", "option");
							li.textContent = zona;

							li.addEventListener(
								"mousedown",
								function (event) {
									event.preventDefault();

									input.value = zona;
									resultsList.classList.add("hidden");
								}
							);

							resultsList.appendChild(li);
						});

						resultsList.classList.remove("hidden");
					} else {
						resultsList.classList.add("hidden");
					}
				}

				input.addEventListener("input", function (event) {
					var target = event.target;

					if (target instanceof HTMLInputElement) {
						filterAndShow(target.value);
					}
				});

				input.addEventListener("focus", function () {
					if (input.value.trim()) {
						filterAndShow(input.value);
					}
				});

				document.addEventListener("click", function (event) {
					var target = event.target;

					if (
						target instanceof Node &&
						!wrapper.contains(target)
					) {
						resultsList.classList.add("hidden");
					}
				});
			}

			if (document.readyState === "loading") {
				document.addEventListener(
					"DOMContentLoaded",
					initAutocomplete
				);
			} else {
				initAutocomplete();
			}
		})();
	</script>
