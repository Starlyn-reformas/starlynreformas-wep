---
import Layout from "../../layouts/Layout.astro";
import { createClient } from "@supabase/supabase-js";

import {
  Plug,
  Droplets,
  ShieldCheck,
  House,
  Wrench,
  Zap,
  Settings2,
  Lightbulb,
  Workflow,
  ClipboardCheck,
  ArrowRight,
  Phone,
  MessageCircle,
  MapPin,
  Check,
  Sparkles,
  Gauge,
  Ruler,
} from "@lucide/astro";
const supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY
);

const {
        data: proyectosInstalaciones,
        error: proyectosInstalacionesError,
} = await supabase
        .from("proyectos")
        .select(
                "id, titulo, descripcion, categoria, imagen, orden, created_at"
        )
        .in("categoria", ["Fontanería", "Electricidad"])
        .eq("publicado", true)
        .not("imagen", "is", null)
        .order("orden", { ascending: true })
        .order("created_at", { ascending: false })
        .limit(6);

const trabajosInstalaciones = proyectosInstalaciones ?? [];

if (proyectosInstalacionesError) {
        console.error(
                "Error cargando proyectos de fontanería y electricidad:",
                proyectosInstalacionesError
        );
}
