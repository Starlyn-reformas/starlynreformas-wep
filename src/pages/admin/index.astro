---
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Administración | STARLYN REFORMAS</title>
  </head>

  <body>
    <div class="admin-layout">

      <!-- =====================================================
           SIDEBAR
      ====================================================== -->

      <aside class="sidebar">

        <div class="sidebar-brand">
          <img
            src="/images/logo-starlyn-reformas.png"
            alt="STARLYN REFORMAS"
          />

          <div class="brand-divider"></div>

          <span>ADMINISTRACIÓN</span>
        </div>

        <nav class="sidebar-nav">

          <a href="/admin" class="nav-item active">

            <span class="nav-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
              >
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <rect x="14" y="14" width="7" height="7" rx="1" />
              </svg>
            </span>

            <span>Proyectos / Trabajos</span>

          </a>

        </nav>

        <div class="sidebar-bottom">

          <a href="/" class="view-site">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path d="M3 11.5 12 4l9 7.5" />
              <path d="M5 10.5V20h14v-9.5" />
              <path d="M9 20v-5h6v5" />
            </svg>

            <span>Ver sitio web</span>

          </a>

          <button id="logout-button" class="logout-button" type="button">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path d="M10 17l5-5-5-5" />
              <path d="M15 12H3" />
              <path d="M21 19V5a2 2 0 0 0-2-2h-6" />
            </svg>

            <span>Cerrar sesión</span>

          </button>

        </div>

      </aside>


      <!-- =====================================================
           CONTENIDO PRINCIPAL
      ====================================================== -->

      <main class="main-content">

        <header class="topbar">

          <div>
            <p class="eyebrow">PANEL DE ADMINISTRACIÓN</p>

            <h1>Proyectos / Trabajos</h1>
          </div>

          <div class="topbar-actions">

            <span class="secure-status">

              <span class="status-dot"></span>

              Sesión segura

            </span>

            <button
              id="mobile-logout"
              class="mobile-logout"
              type="button"
            >
              Cerrar sesión
            </button>

          </div>

        </header>


        <!-- =====================================================
             CONTENIDO
        ====================================================== -->

        <section class="content">

          <div class="section-header">

            <div>

              <p class="section-kicker">
                PORTFOLIO
              </p>

              <h2>
                Trabajos realizados
              </h2>

              <p>
                Gestiona los proyectos que aparecen en la sección
                de trabajos de STARLYN REFORMAS.
              </p>

            </div>

            <button
              class="new-project-button"
              id="new-project"
              type="button"
            >

              <span>+</span>

              Nuevo proyecto

            </button>

          </div>


          <!-- =================================================
               ESTADÍSTICAS
          ================================================== -->

          <div class="stats-grid">

            <div class="stat-card">

              <div class="stat-icon">

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                >
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                  <path d="M8 9h8M8 13h5M8 17h8" />
                </svg>

              </div>

              <div>
                <span class="stat-label">
                  Proyectos
                </span>

                <strong id="stat-total">
                  0
                </strong>
              </div>

            </div>


            <div class="stat-card">

              <div class="stat-icon">

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                >
                  <path d="M12 3v18M3 12h18" />
                </svg>

              </div>

              <div>
                <span class="stat-label">
                  Publicados
                </span>

                <strong id="stat-published">
                  0
                </strong>
              </div>

            </div>


            <div class="stat-card">

              <div class="stat-icon">

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                >
                  <path d="M4 19V5" />
                  <path d="M4 5c4-2 8 2 16 0v10c-8 2-12-2-16 0" />
                </svg>

              </div>

              <div>
                <span class="stat-label">
                  Categorías
                </span>

                <strong id="stat-categories">
                  0
                </strong>
              </div>

            </div>

          </div>


          <!-- =================================================
               LISTA DE PROYECTOS
          ================================================== -->

          <div class="projects-card">

            <div class="projects-card-header">

              <div>

                <h3>
                  Proyectos
                </h3>

                <span>
                  Contenido de la galería pública
                </span>

              </div>

              <div
                id="project-count"
                class="project-count"
              >
                0 proyectos
              </div>

            </div>


            <!-- Aquí JavaScript genera TODOS los proyectos -->

            <div
              id="projects-list"
              class="projects-list"
            ></div>


            <!-- Estado vacío -->

            <div
              id="empty-state"
              class="empty-state"
              hidden
            >

              <div class="empty-icon">

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <rect x="3" y="4" width="18" height="16" rx="2" />
                  <path d="m3 15 5-5 4 4 3-3 6 6" />
                  <circle cx="8" cy="9" r="1.5" />
                </svg>

              </div>

              <h3>
                Todavía no hay proyectos
              </h3>

              <p>
                Añade tu primer trabajo para comenzar a crear
                la galería de STARLYN REFORMAS.
              </p>

              <button
                id="empty-new-project"
                type="button"
                class="empty-button"
              >
                Añadir primer proyecto
              </button>

            </div>

          </div>

        </section>

      </main>

    </div>


    <!-- =======================================================
         MODAL NUEVO / EDITAR PROYECTO
    ======================================================== -->

    <div
      id="project-modal"
      class="modal-backdrop"
      hidden
    >

      <div
        class="modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-title"
      >

        <div class="modal-header">

          <div>

            <p class="modal-kicker">
              GESTIÓN DE PROYECTOS
            </p>

            <h2 id="modal-title">
              Nuevo proyecto
            </h2>

          </div>

          <button
            id="close-modal"
            class="close-modal"
            type="button"
            aria-label="Cerrar"
          >
            ×
          </button>

        </div>


        <form id="project-form">

          <input
            type="hidden"
            id="project-id"
          />


          <!-- IMAGEN -->

          <div class="form-section">

            <label class="form-label">
              Imagen del proyecto
            </label>

            <div
              id="image-dropzone"
              class="image-dropzone"
            >

              <div
                id="image-preview"
                class="image-preview"
                hidden
              >
                <img
                  id="preview-image"
                  src=""
                  alt="Vista previa"
                />

                <button
                  id="remove-image"
                  class="remove-image"
                  type="button"
                  aria-label="Eliminar imagen seleccionada"
                >
                  ×
                </button>
              </div>


              <div
                id="upload-placeholder"
                class="upload-placeholder"
              >

                <div class="upload-icon">

                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path d="M12 16V4" />
                    <path d="m7 9 5-5 5 5" />
                    <path d="M5 20h14" />
                  </svg>

                </div>

                <strong>
                  Selecciona una imagen
                </strong>

                <span>
                  JPG, PNG o WEBP
                </span>

                <button
                  id="choose-image"
                  type="button"
                  class="choose-image"
                >
                  Elegir imagen
                </button>

              </div>

              <input
                id="image-file"
                type="file"
                accept="image/jpeg,image/png,image/webp"
                hidden
              />

            </div>

            <p class="field-help">
              En un proyecto nuevo la imagen es obligatoria.
              Al editar, puedes mantener la imagen actual.
            </p>

          </div>


          <!-- DATOS -->

          <div class="form-grid">

            <div class="form-field full">

              <label for="project-title">
                Título del proyecto *
              </label>

              <input
                id="project-title"
                type="text"
                maxlength="120"
                placeholder="Ej. Reforma integral de baño"
                required
              />

            </div>


            <div class="form-field">

              <label for="project-category">
                Categoría *
              </label>

              <select
                id="project-category"
                required
              >

                <option value="">
                  Seleccionar categoría
                </option>

                <option value="Reformas integrales">
                  Reformas integrales
                </option>

                <option value="Baños">
                  Baños
                </option>

                <option value="Cocinas">
                  Cocinas
                </option>

                <option value="Fontanería">
                  Fontanería
                </option>

                <option value="Electricidad">
                  Electricidad
                </option>

                <option value="Pladur">
                  Pladur
                </option>

                <option value="Alicatados">
                  Alicatados
                </option>

              </select>

            </div>


            <div class="form-field">

              <label for="project-order">
                Orden
              </label>

              <input
                id="project-order"
                type="number"
                min="0"
                step="1"
                value="0"
              />

            </div>


            <div class="form-field full">

              <label for="project-description">
                Descripción
              </label>

              <textarea
                id="project-description"
                maxlength="500"
                rows="4"
                placeholder="Describe brevemente el trabajo realizado..."
              ></textarea>

            </div>


            <div class="form-field full">

              <label class="publish-option">

                <input
                  id="project-published"
                  type="checkbox"
                  checked
                />

                <span class="custom-checkbox">

                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="m5 12 4 4L19 6" />
                  </svg>

                </span>

                <span>
                  Publicar este proyecto en la web
                </span>

              </label>

            </div>

          </div>


          <!-- MENSAJE -->

          <div
            id="form-message"
            class="form-message"
            hidden
          ></div>


          <!-- ACCIONES -->

          <div class="modal-actions">

            <button
              id="cancel-modal"
              type="button"
              class="cancel-button"
            >
              Cancelar
            </button>

            <button
              id="save-project"
              type="submit"
              class="save-button"
            >
              <span id="save-text">
                Guardar proyecto
              </span>

              <span
                id="save-spinner"
                class="spinner"
                hidden
              ></span>
            </button>

          </div>

        </form>

      </div>

    </div>


    <!-- =======================================================
         CONFIRMACIÓN ELIMINAR
    ======================================================== -->

    <div
      id="delete-modal"
      class="modal-backdrop"
      hidden
    >

      <div class="confirm-modal">

        <div class="confirm-icon">

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
          >
            <path d="M12 3 2.8 20h18.4L12 3Z" />
            <path d="M12 9v5" />
            <path d="M12 17h.01" />
          </svg>

        </div>

        <h2>
          ¿Eliminar proyecto?
        </h2>

        <p id="delete-description">
          Esta acción eliminará el proyecto de la galería.
        </p>

        <div class="confirm-actions">

          <button
            id="cancel-delete"
            type="button"
            class="cancel-button"
          >
            Cancelar
          </button>

          <button
            id="confirm-delete"
            type="button"
            class="delete-confirm-button"
          >
            Eliminar
          </button>

        </div>

      </div>

    </div>


    <!-- =======================================================
         JAVASCRIPT
    ======================================================== -->

    <script>
      import { supabase } from '../../lib/supabase/client';


      /* =========================================================
         REFERENCIAS
      ========================================================== */

      const projectsList =
        document.querySelector('#projects-list');

      const emptyState =
        document.querySelector('#empty-state');

      const projectModal =
        document.querySelector('#project-modal');

      const deleteModal =
        document.querySelector('#delete-modal');

      const projectForm =
        document.querySelector('#project-form');

      const imageFile =
        document.querySelector('#image-file');

      const imagePreview =
        document.querySelector('#image-preview');

      const previewImage =
        document.querySelector('#preview-image');

      const uploadPlaceholder =
        document.querySelector('#upload-placeholder');

      const formMessage =
        document.querySelector('#form-message');

      const saveButton =
        document.querySelector('#save-project');

      const saveText =
        document.querySelector('#save-text');

      const saveSpinner =
        document.querySelector('#save-spinner');

      let projects = [];

      let selectedFile = null;

      let editingProject = null;

      let projectToDelete = null;


      /* =========================================================
         UTILIDADES
      ========================================================== */

      const escapeHtml = (value) => {

        return String(value ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');

      };


      const getImagePathFromStorageUrl = (url) => {

        if (!url) return null;

        const marker =
          '/storage/v1/object/public/proyectos/';

        const index =
          url.indexOf(marker);

        if (index === -1) {
          return null;
        }

        return decodeURIComponent(
          url.slice(index + marker.length)
        );

      };


      const showFormMessage = (
        message,
        type = 'error'
      ) => {

        if (!formMessage) return;

        formMessage.hidden = false;

        formMessage.className =
          `form-message ${type}`;

        formMessage.textContent =
          message;

      };


      const hideFormMessage = () => {

        if (!formMessage) return;

        formMessage.hidden = true;

        formMessage.textContent = '';

      };


      const setSaving = (saving) => {

        if (!saveButton) return;

        saveButton.disabled = saving;

        if (saveText) {

          saveText.textContent =
            saving
              ? 'Guardando...'
              : (
                editingProject
                  ? 'Guardar cambios'
                  : 'Guardar proyecto'
              );

        }

        if (saveSpinner) {
          saveSpinner.hidden = !saving;
        }

      };


      /* =========================================================
         CERRAR SESIÓN
      ========================================================== */

      const logout = async () => {

        await supabase.auth.signOut();

        window.location.href =
          '/admin/login';

      };


      document
        .querySelector('#logout-button')
        ?.addEventListener(
          'click',
          logout
        );


      document
        .querySelector('#mobile-logout')
        ?.addEventListener(
          'click',
          logout
        );


      /* =========================================================
         RENDERIZAR PROYECTOS
      ========================================================== */

      const renderProjects = () => {

        if (!projectsList) return;

        projectsList.innerHTML = '';


        if (projects.length === 0) {

          projectsList.hidden = true;

          if (emptyState) {
            emptyState.hidden = false;
          }

          return;

        }


        projectsList.hidden = false;

        if (emptyState) {
          emptyState.hidden = true;
        }


        projects.forEach((project) => {

          const row =
            document.createElement('article');

          row.className =
            'project-row';


          const image =
            escapeHtml(
              project.imagen ||
              '/images/og-default.jpg'
            );


          const title =
            escapeHtml(
              project.titulo ||
              'Proyecto sin título'
            );


          const description =
            escapeHtml(
              project.descripcion ||
              'Sin descripción'
            );


          const category =
            escapeHtml(
              project.categoria ||
              'Sin categoría'
            );


          const isPublished =
            project.publicado === true;


          row.innerHTML = `

            <div class="project-image">

              <img
                src="${image}"
                alt="${title}"
                loading="lazy"
              />

              <div class="image-badge">
                ${isPublished ? 'Publicado' : 'No publicado'}
              </div>

            </div>


            <div class="project-info">

              <span class="project-small-label">
                PROYECTO
              </span>

              <h4>
                ${title}
              </h4>

              <p>
                ${description}
              </p>

              <div class="project-meta">

                <span class="category">
                  ${category}
                </span>

                <span
                  class="published ${
                    isPublished
                      ? ''
                      : 'not-published'
                  }"
                >

                  <span class="published-dot"></span>

                  ${
                    isPublished
                      ? 'Publicado'
                      : 'No publicado'
                  }

                </span>

              </div>

            </div>


            <div class="project-actions">

              <button
                type="button"
                class="action-button edit-project"
                data-id="${project.id}"
              >

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                >
                  <path d="M12 20h9" />
                  <path
                    d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"
                  />
                </svg>

                <span>
                  Editar
                </span>

              </button>


              <button
                type="button"
                class="action-button toggle-project"
                data-id="${project.id}"
              >

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                >
                  ${
                    isPublished
                      ? `
                        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
                        <circle cx="12" cy="12" r="2.5" />
                      `
                      : `
                        <path d="M3 3l18 18" />
                        <path d="M10.6 6.2A10.8 10.8 0 0 1 12 6c6.5 0 10 6 10 6a18 18 0 0 1-3.2 3.7" />
                        <path d="M6.7 6.8C3.6 8.6 2 12 2 12s3.5 6 10 6c1.1 0 2.1-.2 3-.5" />
                      `
                  }
                </svg>

                <span>
                  ${
                    isPublished
                      ? 'Ocultar'
                      : 'Publicar'
                  }
                </span>

              </button>


              <button
                type="button"
                class="action-button delete delete-project"
                data-id="${project.id}"
              >

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                >
                  <path d="M3 6h18" />
                  <path d="M8 6V4h8v2" />
                  <path d="m19 6-1 15H6L5 6" />
                  <path d="M10 11v6M14 11v6" />
                </svg>

                <span>
                  Eliminar
                </span>

              </button>

            </div>

          `;


          projectsList.appendChild(row);

        });


        attachProjectActions();

      };


      /* =========================================================
         ESTADÍSTICAS
      ========================================================== */

      const updateStats = () => {

        const total =
          projects.length;


        const published =
          projects.filter(
            (project) =>
              project.publicado === true
          ).length;


        const categories =
          new Set(
            projects
              .map(
                (project) =>
                  project.categoria
              )
              .filter(Boolean)
          ).size;


        const totalElement =
          document.querySelector(
            '#stat-total'
          );


        const publishedElement =
          document.querySelector(
            '#stat-published'
          );


        const categoriesElement =
          document.querySelector(
            '#stat-categories'
          );


        if (totalElement) {
          totalElement.textContent =
            String(total);
        }


        if (publishedElement) {
          publishedElement.textContent =
            String(published);
        }


        if (categoriesElement) {
          categoriesElement.textContent =
            String(categories);
        }


        const projectCount =
          document.querySelector(
            '#project-count'
          );


        if (projectCount) {

          projectCount.textContent =
            `${total} ${
              total === 1
                ? 'proyecto'
                : 'proyectos'
            }`;

        }

      };


      /* =========================================================
         CARGAR PROYECTOS
      ========================================================== */

      const loadProjects = async () => {

        try {

          if (projectsList) {

            projectsList.innerHTML = `
              <div class="loading-state">
                <span class="loading-spinner"></span>
                Cargando proyectos...
              </div>
            `;

          }


          const {
            data,
            error
          } = await supabase
            .from('proyectos')
            .select('*')
            .order(
              'orden',
              {
                ascending: true
              }
            )
            .order(
              'created_at',
              {
                ascending: false
              }
            );


          if (error) {

            console.error(
              'Error cargando proyectos:',
              error
            );

            if (projectsList) {

              projectsList.innerHTML = `
                <div class="error-state">
                  No se pudieron cargar los proyectos.
                  Revisa la conexión con Supabase.
                </div>
              `;

            }

            return;

          }


          projects =
            data ?? [];


          updateStats();

          renderProjects();

        } catch (error) {

          console.error(
            'Error inesperado cargando proyectos:',
            error
          );

        }

      };


      /* =========================================================
         ABRIR MODAL NUEVO
      ========================================================== */

      const openNewProjectModal = () => {

        editingProject = null;

        selectedFile = null;

        if (projectForm) {
          projectForm.reset();
        }


        const idInput =
          document.querySelector(
            '#project-id'
          );

        const orderInput =
          document.querySelector(
            '#project-order'
          );


        if (idInput) {
          idInput.value = '';
        }


        if (orderInput) {
          orderInput.value =
            String(projects.length + 1);
        }


        const published =
          document.querySelector(
            '#project-published'
          );


        if (published) {
          published.checked = true;
        }


        const modalTitle =
          document.querySelector(
            '#modal-title'
          );


        if (modalTitle) {
          modalTitle.textContent =
            'Nuevo proyecto';
        }


        if (saveText) {
          saveText.textContent =
            'Guardar proyecto';
        }


        hideFormMessage();

        clearImagePreview();

        projectModal.hidden = false;

        document.body.classList.add(
          'modal-open'
        );


        setTimeout(() => {

          document
            .querySelector(
              '#project-title'
            )
            ?.focus();

        }, 50);

      };


      /* =========================================================
         ABRIR MODAL EDITAR
      ========================================================== */

      const openEditProjectModal = (
        project
      ) => {

        editingProject =
          project;


        selectedFile =
          null;


        const idInput =
          document.querySelector(
            '#project-id'
          );

        const titleInput =
          document.querySelector(
            '#project-title'
          );

        const categoryInput =
          document.querySelector(
            '#project-category'
          );

        const descriptionInput =
          document.querySelector(
            '#project-description'
          );

        const orderInput =
          document.querySelector(
            '#project-order'
          );

        const publishedInput =
          document.querySelector(
            '#project-published'
          );


        if (idInput) {
          idInput.value =
            String(project.id);
        }


        if (titleInput) {
          titleInput.value =
            project.titulo || '';
        }


        if (categoryInput) {
          categoryInput.value =
            project.categoria || '';
        }


        if (descriptionInput) {
          descriptionInput.value =
            project.descripcion || '';
        }


        if (orderInput) {
          orderInput.value =
            String(project.orden ?? 0);
        }


        if (publishedInput) {
          publishedInput.checked =
            project.publicado === true;
        }


        const modalTitle =
          document.querySelector(
            '#modal-title'
          );


        if (modalTitle) {
          modalTitle.textContent =
            'Editar proyecto';
        }


        if (saveText) {
          saveText.textContent =
            'Guardar cambios';
        }


        hideFormMessage();


        if (project.imagen) {

          previewImage.src =
            project.imagen;

          previewImage.alt =
            project.titulo ||
            'Imagen del proyecto';

          imagePreview.hidden = false;

          uploadPlaceholder.hidden = true;

        } else {

          clearImagePreview();

        }


        projectModal.hidden = false;

        document.body.classList.add(
          'modal-open'
        );

      };


      /* =========================================================
         CERRAR MODAL
      ========================================================== */

      const closeProjectModal = () => {

        projectModal.hidden = true;

        document.body.classList.remove(
          'modal-open'
        );

        editingProject = null;

        selectedFile = null;

        hideFormMessage();

      };


      document
        .querySelector('#new-project')
        ?.addEventListener(
          'click',
          openNewProjectModal
        );


      document
        .querySelector('#empty-new-project')
        ?.addEventListener(
          'click',
          openNewProjectModal
        );


      document
        .querySelector('#close-modal')
        ?.addEventListener(
          'click',
          closeProjectModal
        );


      document
        .querySelector('#cancel-modal')
        ?.addEventListener(
          'click',
          closeProjectModal
        );


      projectModal
        ?.addEventListener(
          'click',
          (event) => {

            if (
              event.target === projectModal
            ) {
              closeProjectModal();
            }

          }
        );


      /* =========================================================
         SELECCIÓN DE IMAGEN
      ========================================================== */

      const chooseImage = () => {

        imageFile?.click();

      };


      document
        .querySelector('#choose-image')
        ?.addEventListener(
          'click',
          chooseImage
        );


      document
        .querySelector('#image-dropzone')
        ?.addEventListener(
          'click',
          (event) => {

            const target =
              event.target;

            if (
              target instanceof HTMLElement &&
              (
                target.closest(
                  '#remove-image'
                ) ||
                target.closest(
                  '#choose-image'
                )
              )
            ) {
              return;
            }


            imageFile?.click();

          }
        );


      imageFile
        ?.addEventListener(
          'change',
          () => {

            const file =
              imageFile.files?.[0];


            if (!file) {
              return;
            }


            const allowedTypes = [
              'image/jpeg',
              'image/png',
              'image/webp'
            ];


            if (
              !allowedTypes.includes(
                file.type
              )
            ) {

              showFormMessage(
                'Selecciona una imagen JPG, PNG o WEBP.',
                'error'
              );

              imageFile.value = '';

              return;

            }


            /*
             * Límite razonable para evitar archivos
             * demasiado pesados.
             */

            const maxSize =
              10 * 1024 * 1024;


            if (
              file.size > maxSize
            ) {

              showFormMessage(
                'La imagen no puede superar los 10 MB.',
                'error'
              );

              imageFile.value = '';

              return;

            }


            selectedFile =
              file;


            const reader =
              new FileReader();


            reader.onload = () => {

              if (
                typeof reader.result ===
                'string'
              ) {

                previewImage.src =
                  reader.result;

                previewImage.alt =
                  file.name;

                imagePreview.hidden =
                  false;

                uploadPlaceholder.hidden =
                  true;

              }

            };


            reader.readAsDataURL(file);

            hideFormMessage();

          }
        );


      const clearImagePreview = () => {

        selectedFile = null;

        if (imageFile) {
          imageFile.value = '';
        }


        if (imagePreview) {
          imagePreview.hidden = true;
        }


        if (uploadPlaceholder) {
          uploadPlaceholder.hidden = false;
        }


        if (previewImage) {
          previewImage.src = '';
        }

      };


      document
        .querySelector('#remove-image')
        ?.addEventListener(
          'click',
          (event) => {

            event.stopPropagation();

            clearImagePreview();

          }
        );


      /* =========================================================
         SUBIR IMAGEN A STORAGE
      ========================================================== */

      const uploadProjectImage = async (
        file
      ) => {

        const originalName =
          file.name
            .toLowerCase()
            .normalize('NFD')
            .replace(
              /[\u0300-\u036f]/g,
              ''
            )
            .replace(
              /[^a-z0-9._-]+/g,
              '-'
            )
            .replace(
              /^-+|-+$/g,
              ''
            );


        const extension =
          originalName.includes('.')
            ? originalName
                .split('.')
                .pop()
            : 'jpg';


        const baseName =
          originalName
            .replace(
              /\.[^/.]+$/,
              ''
            )
            .slice(0, 80) ||
          'proyecto';


        const filePath =
          `proyectos/${crypto.randomUUID()}-${baseName}.${extension}`;


        const {
          error
        } = await supabase.storage
          .from('proyectos')
          .upload(
            filePath,
            file,
            {
              cacheControl: '3600',
              upsert: false,
              contentType: file.type
            }
          );


        if (error) {

          throw new Error(
            `No se pudo subir la imagen: ${error.message}`
          );

        }


        const {
          data
        } = supabase.storage
          .from('proyectos')
          .getPublicUrl(
            filePath
          );


        if (!data?.publicUrl) {

          throw new Error(
            'La imagen se subió, pero no se pudo obtener su URL pública.'
          );

        }


        return data.publicUrl;

      };


      /* =========================================================
         GUARDAR PROYECTO
      ========================================================== */

      projectForm
        ?.addEventListener(
          'submit',
          async (event) => {

            event.preventDefault();

            hideFormMessage();

            setSaving(true);


            try {

              const titleInput =
                document.querySelector(
                  '#project-title'
                );

              const categoryInput =
                document.querySelector(
                  '#project-category'
                );

              const descriptionInput =
                document.querySelector(
                  '#project-description'
                );

              const orderInput =
                document.querySelector(
                  '#project-order'
                );

              const publishedInput =
                document.querySelector(
                  '#project-published'
                );


              const titulo =
                titleInput?.value.trim() || '';


              const categoria =
                categoryInput?.value || '';


              const descripcion =
                descriptionInput?.value.trim() || '';


              const orden =
                Number(
                  orderInput?.value || 0
                );


              const publicado =
                publishedInput?.checked === true;


              if (!titulo) {

                showFormMessage(
                  'Escribe un título para el proyecto.',
                  'error'
                );

                setSaving(false);

                return;

              }


              if (!categoria) {

                showFormMessage(
                  'Selecciona una categoría.',
                  'error'
                );

                setSaving(false);

                return;

              }


              /*
               * PROYECTO NUEVO
               */

              if (!editingProject) {

                if (!selectedFile) {

                  showFormMessage(
                    'Selecciona una imagen para el proyecto.',
                    'error'
                  );

                  setSaving(false);

                  return;

                }


                const imageUrl =
                  await uploadProjectImage(
                    selectedFile
                  );


                const {
                  error
                } = await supabase
                  .from('proyectos')
                  .insert({
                    titulo,
                    descripcion,
                    imagen: imageUrl,
                    categoria,
                    publicado,
                    orden: Number.isFinite(orden)
                      ? orden
                      : 0
                  });


                if (error) {

                  /*
                   * Si falla el registro, intentamos
                   * eliminar la imagen recién subida.
                   */

                  const uploadedPath =
                    getImagePathFromStorageUrl(
                      imageUrl
                    );


                  if (uploadedPath) {

                    await supabase.storage
                      .from('proyectos')
                      .remove([
                        uploadedPath
                      ]);

                  }


                  throw new Error(
                    `No se pudo guardar el proyecto: ${error.message}`
                  );

                }


                showFormMessage(
                  'Proyecto creado correctamente.',
                  'success'
                );

              }


              /*
               * EDITAR PROYECTO EXISTENTE
               */

              else {

                let imageUrl =
                  editingProject.imagen;


                /*
                 * Si seleccionamos una imagen nueva,
                 * primero la subimos.
                 */

                if (selectedFile) {

                  imageUrl =
                    await uploadProjectImage(
                      selectedFile
                    );

                }


                const {
                  error
                } = await supabase
                  .from('proyectos')
                  .update({
                    titulo,
                    descripcion,
                    imagen: imageUrl,
                    categoria,
                    publicado,
                    orden: Number.isFinite(orden)
                      ? orden
                      : 0
                  })
                  .eq(
                    'id',
                    editingProject.id
                  );


                if (error) {

                  /*
                   * Si falló el update y habíamos subido
                   * una nueva imagen, la eliminamos para
                   * no dejar archivos huérfanos.
                   */

                  if (
                    selectedFile &&
                    imageUrl &&
                    imageUrl !==
                      editingProject.imagen
                  ) {

                    const uploadedPath =
                      getImagePathFromStorageUrl(
                        imageUrl
                      );


                    if (uploadedPath) {

                      await supabase.storage
                        .from('proyectos')
                        .remove([
                          uploadedPath
                        ]);

                    }

                  }


                  throw new Error(
                    `No se pudieron guardar los cambios: ${error.message}`
                  );

                }


                /*
                 * Si todo salió bien y había una imagen
                 * anterior almacenada en nuestro bucket,
                 * la eliminamos.
                 *
                 * Las imágenes antiguas tipo
                 * /trabajos/bano1.jpg NO se tocan.
                 */

                if (
                  selectedFile &&
                  editingProject.imagen &&
                  imageUrl !==
                    editingProject.imagen
                ) {

                  const oldPath =
                    getImagePathFromStorageUrl(
                      editingProject.imagen
                    );


                  if (oldPath) {

                    await supabase.storage
                      .from('proyectos')
                      .remove([
                        oldPath
                      ]);

                  }

                }


                showFormMessage(
                  'Proyecto actualizado correctamente.',
                  'success'
                );

              }


              /*
               * Esperamos un momento para que el usuario
               * pueda ver el mensaje de confirmación.
               */

              await new Promise(
                (resolve) =>
                  setTimeout(
                    resolve,
                    500
                  )
              );


              closeProjectModal();

              await loadProjects();

            } catch (error) {

              console.error(
                'Error guardando proyecto:',
                error
              );


              showFormMessage(
                error instanceof Error
                  ? error.message
                  : 'Ha ocurrido un error al guardar el proyecto.',
                'error'
              );

            } finally {

              setSaving(false);

            }

          }
        );


      /* =========================================================
         ACCIONES DE PROYECTOS
      ========================================================== */

      const attachProjectActions = () => {

        document
          .querySelectorAll(
            '.edit-project'
          )
          .forEach((button) => {

            button.addEventListener(
              'click',
              () => {

                const id =
                  Number(
                    button.getAttribute(
                      'data-id'
                    )
                  );


                const project =
                  projects.find(
                    (item) =>
                      Number(item.id) === id
                  );


                if (project) {
                  openEditProjectModal(
                    project
                  );
                }

              }
            );

          });


        document
          .querySelectorAll(
            '.toggle-project'
          )
          .forEach((button) => {

            button.addEventListener(
              'click',
              async () => {

                const id =
                  Number(
                    button.getAttribute(
                      'data-id'
                    )
                  );


                const project =
                  projects.find(
                    (item) =>
                      Number(item.id) === id
                  );


                if (!project) return;


                button.disabled = true;


                try {

                  const {
                    error
                  } = await supabase
                    .from('proyectos')
                    .update({
                      publicado:
                        !project.publicado
                    })
                    .eq(
                      'id',
                      project.id
                    );


                  if (error) {
                    throw error;
                  }


                  await loadProjects();

                } catch (error) {

                  console.error(
                    'Error cambiando publicación:',
                    error
                  );


                  alert(
                    'No se pudo cambiar el estado de publicación.'
                  );


                  button.disabled =
                    false;

                }

              }
            );

          });


        document
          .querySelectorAll(
            '.delete-project'
          )
          .forEach((button) => {

            button.addEventListener(
              'click',
              () => {

                const id =
                  Number(
                    button.getAttribute(
                      'data-id'
                    )
                  );


                const project =
                  projects.find(
                    (item) =>
                      Number(item.id) === id
                  );


                if (!project) return;


                projectToDelete =
                  project;


                const deleteDescription =
                  document.querySelector(
                    '#delete-description'
                  );


                if (deleteDescription) {

                  deleteDescription.textContent =
                    `Se eliminará "${project.titulo}" de la galería. Esta acción no se puede deshacer.`;

                }


                deleteModal.hidden =
                  false;


                document.body.classList.add(
                  'modal-open'
                );

              }
            );

          });

      };


      /* =========================================================
         ELIMINAR PROYECTO
      ========================================================== */

      const closeDeleteModal = () => {

        deleteModal.hidden =
          true;

        document.body.classList.remove(
          'modal-open'
        );

        projectToDelete =
          null;

      };


      document
        .querySelector('#cancel-delete')
        ?.addEventListener(
          'click',
          closeDeleteModal
        );


      deleteModal
        ?.addEventListener(
          'click',
          (event) => {

            if (
              event.target === deleteModal
            ) {
              closeDeleteModal();
            }

          }
        );


      document
        .querySelector('#confirm-delete')
        ?.addEventListener(
          'click',
          async () => {

            if (!projectToDelete) {
              return;
            }


            const project =
              projectToDelete;


            const confirmButton =
              document.querySelector(
                '#confirm-delete'
              );


            if (confirmButton) {

              confirmButton.disabled =
                true;

              confirmButton.textContent =
                'Eliminando...';

            }


            try {

              /*
               * Primero eliminamos el registro
               * de la tabla.
               */

              const {
                error
              } = await supabase
                .from('proyectos')
                .delete()
                .eq(
                  'id',
                  project.id
                );


              if (error) {
                throw error;
              }


              /*
               * Si la imagen pertenece al bucket
               * proyectos, eliminamos también
               * el archivo.
               *
               * Las imágenes antiguas como
               * /trabajos/bano1.jpg no se tocan.
               */

              const storagePath =
                getImagePathFromStorageUrl(
                  project.imagen
                );


              if (storagePath) {

                const {
                  error:
                    storageError
                } = await supabase.storage
                  .from('proyectos')
                  .remove([
                    storagePath
                  ]);


                if (storageError) {

                  console.warn(
                    'El proyecto fue eliminado, pero no se pudo eliminar la imagen de Storage:',
                    storageError
                  );

                }

              }


              closeDeleteModal();

              await loadProjects();

            } catch (error) {

              console.error(
                'Error eliminando proyecto:',
                error
              );


              alert(
                error instanceof Error
                  ? error.message
                  : 'No se pudo eliminar el proyecto.'
              );


              if (confirmButton) {

                confirmButton.disabled =
                  false;

                confirmButton.textContent =
                  'Eliminar';

              }

            }

          }
        );


      /* =========================================================
         ESC PARA CERRAR MODALES
      ========================================================== */

      document.addEventListener(
        'keydown',
        (event) => {

          if (
            event.key !== 'Escape'
          ) {
            return;
          }


          if (
            projectModal &&
            !projectModal.hidden
          ) {

            closeProjectModal();

          }


          if (
            deleteModal &&
            !deleteModal.hidden
          ) {

            closeDeleteModal();

          }

        }
      );


      /* =========================================================
         INICIAR
      ========================================================== */

      loadProjects();

    </script>


