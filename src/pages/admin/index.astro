        min-height: 46px;
        padding: 0 18px;
        border: 1px solid #102a43;
        border-radius: 9px;
        background: #102a43;
        color: #fff;
        font: inherit;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        box-shadow: 0 8px 20px rgba(16,42,67,.12);
        transition: background .25s ease, border-color .25s ease, box-shadow .25s ease;
      }

      .new-project-button span {
        color: #d2b06a;
        font-size: 19px;
        line-height: 1;
        font-weight: 400;
      }

      .new-project-button:hover {
        background: #173b57;
        border-color: #173b57;
        box-shadow: 0 10px 25px rgba(16,42,67,.17);
      }

      /* ========================= STATS ========================= */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
      }

      .stat-card {
        min-height: 118px;
        display: flex;
        align-items: center;
        gap: 17px;
        padding: 22px;
        border: 1px solid #e6ddd1;
        border-radius: 13px;
        background: #fff;
        box-shadow: 0 5px 22px rgba(16,42,67,.045);
        transition: border-color .25s ease, box-shadow .25s ease;
      }

      .stat-card:hover {
        border-color: #d8c7ad;
        box-shadow: 0 8px 28px rgba(16,42,67,.07);
      }

      .stat-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid #e8ded0;
        border-radius: 11px;
        background: #f7f4ee;
        color: #b58a3a;
      }

      .stat-icon svg { width: 24px; height: 24px; }

      .stat-label {
        display: block;
        margin-bottom: 4px;
        color: #687078;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
      }

      .stat-card strong {
        color: #102a43;
        font-size: 29px;
        line-height: 1;
        font-weight: 750;
      }

      /* ========================= PROJECTS ========================= */
      .projects-card {
        overflow: hidden;
        border: 1px solid #e6ddd1;
        border-radius: 15px;
        background: #fff;
        box-shadow: 0 6px 26px rgba(16,42,67,.05);
      }

      .projects-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 18px 22px;
        border-bottom: 1px solid #eee7de;
        background: #fffdfa;
      }

      .projects-card-header h3 {
        margin: 0;
        color: #102a43;
        font-size: 14px;
        font-weight: 750;
      }

      .project-count {
        color: #687078;
        font-size: 11px;
        font-weight: 600;
      }

      .project-row {
        display: grid;
        grid-template-columns: 190px minmax(0, 1fr) auto;
        align-items: center;
        gap: 24px;
        padding: 19px 22px;
        border-bottom: 1px solid #eee7de;
        transition: background .2s ease;
      }

      .project-row:last-child { border-bottom: 0; }
      .project-row:hover { background: #fcfaf6; }

      .project-image {
        width: 190px;
        height: 132px;
        position: relative;
        overflow: hidden;
        border-radius: 10px;
        background: #e8ded0;
      }

      .project-image img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        transition: transform .45s ease;
      }

      .project-row:hover .project-image img { transform: scale(1.025); }

      .image-badge {
        position: absolute;
        left: 9px;
        top: 9px;
        padding: 5px 8px;
        border-radius: 999px;
        background: rgba(16,42,67,.9);
        color: #fff;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .1em;
        text-transform: uppercase;
      }

      .project-info { min-width: 0; }

      .project-small-label {
        display: block;
        margin-bottom: 6px;
        color: #b58a3a;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
      }

      .project-info h4 {
        margin: 0 0 7px;
        color: #102a43;
        font-size: 18px;
        line-height: 1.25;
        font-weight: 750;
        letter-spacing: -.015em;
      }

      .project-info p {
        margin: 0 0 10px;
        max-width: 700px;
        color: #687078;
        font-size: 12px;
        line-height: 1.6;
      }

      .project-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
      }

      .category, .published, .not-published {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 25px;
        padding: 0 9px;
        border-radius: 999px;
        font-size: 9px;
        font-weight: 750;
        letter-spacing: .06em;
        text-transform: uppercase;
      }

      .category {
        color: #294d67;
        background: #edf2f4;
        border: 1px solid #dce6ea;
      }

      .published {
        color: #315c48;
        background: #eef6f0;
        border: 1px solid #d5e8db;
      }

      .published .published-dot { width: 6px; height: 6px; background: #4c8a67; box-shadow: none; }

      .not-published {
        color: #77705f;
        background: #f5f1e9;
        border: 1px solid #e8ded0;
      }

      .project-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 7px;
        min-width: 205px;
      }

      .action-button {
        min-height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 0 10px;
        border: 1px solid #ddd4c8;
        border-radius: 8px;
        background: #fff;
        color: #53606a;
        font: inherit;
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: color .2s ease, border-color .2s ease, background .2s ease;
      }

      .action-button:hover {
        color: #102a43;
        border-color: #b9a88e;
        background: #f7f4ee;
      }

      .action-button.publish:hover { color: #315c48; border-color: #a8cbb3; background: #f2f8f3; }
      .action-button.delete, .delete-project { color: #9b4d48; }
      .action-button.delete:hover, .delete-project:hover { color: #8b3430; border-color: #ddb3af; background: #fff6f5; }

      /* ========================= EMPTY / STATUS ========================= */
      .empty-state, .loading-state, .error-state {
        padding: 58px 25px;
        text-align: center;
      }

      .empty-icon, .confirm-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
        border-radius: 50%;
        background: #f7f4ee;
        border: 1px solid #e8ded0;
        color: #b58a3a;
      }

      .empty-icon svg, .confirm-icon svg { width: 25px; height: 25px; }

      .empty-state h3, .error-state h3 {
        margin: 0 0 7px;
        color: #102a43;
        font-size: 17px;
      }

      .empty-state p, .error-state p, .loading-state p {
        max-width: 480px;
        margin: 0 auto 17px;
        color: #687078;
        font-size: 12px;
        line-height: 1.6;
      }

      .empty-button {
        min-height: 40px;
        padding: 0 15px;
        border: 1px solid #102a43;
        border-radius: 8px;
        background: #102a43;
        color: #fff;
        font: inherit;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
      }

      .empty-button:hover { background: #173b57; }
      .error-state { color: #9b4d48; }

      .loading-spinner, .spinner {
        width: 30px;
        height: 30px;
        margin: 0 auto 12px;
        border: 2px solid #e8ded0;
        border-top-color: #b58a3a;
        border-radius: 50%;
        animation: spin .8s linear infinite;
      }

      @keyframes spin { to { transform: rotate(360deg); } }

      /* ========================= MODAL ========================= */
      
      [hidden] {
  display: none !important;
}
      .modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 22px;
        background: rgba(8,22,34,.62);
        backdrop-filter: blur(6px);
      }

      .modal {
        width: min(720px, 100%);
        max-height: calc(100vh - 44px);
        overflow-y: auto;
        border: 1px solid #e8ded0;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 28px 80px rgba(5,20,32,.28);
      }

      .modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        padding: 23px 25px 19px;
        border-bottom: 1px solid #eee7de;
      }

      .modal-header h2 {
        margin: 0;
        color: #102a43;
        font-size: 23px;
        line-height: 1.2;
      }

      .modal-kicker { margin-bottom: 6px; }

      .close-modal {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid #e1d8cc;
        border-radius: 8px;
        background: #fff;
        color: #687078;
        font: inherit;
        font-size: 21px;
        line-height: 1;
        cursor: pointer;
      }

      .close-modal:hover { color: #102a43; background: #f7f4ee; border-color: #cbbba4; }

      .modal form { padding: 24px 25px 25px; }

      .form-section {
        margin-bottom: 24px;
        padding-bottom: 23px;
        border-bottom: 1px solid #eee7de;
      }

      .form-section:last-of-type { margin-bottom: 0; border-bottom: 0; }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 17px;
      }

      .form-field.full { grid-column: 1 / -1; }

      .form-label {
        display: block;
        margin-bottom: 7px;
        color: #294d67;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      .form-field input:not([type="checkbox"]), .form-field textarea, .form-field select {
        width: 100%;
        border: 1px solid #ddd4c8;
        border-radius: 8px;
        background: #fffdfa;
        color: #3f4548;
        font: inherit;
        font-size: 12px;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
      }

      .form-field input:not([type="checkbox"]), .form-field select {
        min-height: 43px;
        padding: 0 12px;
      }

      .form-field textarea { min-height: 108px; padding: 11px 12px; resize: vertical; }

      .form-field input:not([type="checkbox"]):focus, .form-field textarea:focus, .form-field select:focus {
        border-color: #b58a3a;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(181,138,58,.1);
      }

      .field-help {
        margin: 6px 0 0;
        color: #8a8e91;
        font-size: 10px;
        line-height: 1.5;
      }

      .custom-checkbox, .publish-option {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #53606a;
        font-size: 11px;
        font-weight: 600;
      }

      .custom-checkbox input, .publish-option input { accent-color: #b58a3a; }

      .image-dropzone {
        min-height: 210px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 1.5px dashed #cfc2b0;
        border-radius: 11px;
        background: #faf7f2;
        cursor: pointer;
        transition: border-color .2s ease, background .2s ease;
      }

      .image-dropzone:hover {
        border-color: #b58a3a;
        background: #fffaf2;
      }

      .upload-placeholder { padding: 28px; text-align: center; }

      .upload-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px;
        border-radius: 50%;
        background: #fff;
        border: 1px solid #e8ded0;
        color: #b58a3a;
      }

      .upload-icon svg { width: 21px; height: 21px; }
      .upload-placeholder strong { display: block; margin-bottom: 4px; color: #102a43; font-size: 12px; }
      .upload-placeholder span { color: #8a8e91; font-size: 10px; }

      .image-preview {
        position: absolute;
        inset: 0;
        display: none;
        background: #e8ded0;
      }

      .image-preview img { width: 100%; height: 100%; display: block; object-fit: cover; }

      .remove-image {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,.55);
        border-radius: 50%;
        background: rgba(16,42,67,.88);
        color: #fff;
        cursor: pointer;
      }

      .remove-image:hover { background: #9b4d48; }

      .modal-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 9px;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid #eee7de;
      }

      .cancel-button, .save-button, .delete-confirm-button {
        min-height: 42px;
        padding: 0 17px;
        border-radius: 8px;
        font: inherit;
        font-size: 11px;
        font-weight: 750;
        cursor: pointer;
      }

      .cancel-button {
        border: 1px solid #ddd4c8;
        background: #fff;
        color: #53606a;
      }

      .cancel-button:hover { background: #f7f4ee; color: #102a43; }

      .save-button {
        border: 1px solid #102a43;
        background: #102a43;
        color: #fff;
        box-shadow: 0 7px 18px rgba(16,42,67,.12);
      }

      .save-button:hover { background: #173b57; }

      .form-message {
        margin-top: 12px;
        padding: 10px 12px;
        border-radius: 8px;
        font-size: 11px;
        line-height: 1.5;
      }

      .form-message.success { color: #315c48; background: #eef6f0; border: 1px solid #d5e8db; }
      .form-message.error { color: #8b3430; background: #fff6f5; border: 1px solid #e4c4c1; }

      /* ========================= DELETE MODAL ========================= */
      .confirm-modal {
        width: min(430px, 100%);
        padding: 30px;
        text-align: center;
        border: 1px solid #e8ded0;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 28px 80px rgba(5,20,32,.28);
      }

      .confirm-icon {
        margin-bottom: 16px;
        color: #9b4d48;
        background: #fff6f5;
        border-color: #ead0cd;
      }

      .confirm-modal h2 { margin: 0 0 8px; color: #102a43; font-size: 21px; }
      .confirm-modal p { margin: 0 auto; color: #687078; font-size: 12px; line-height: 1.6; }

.confirm-actions {
  display: flex;
  align-items: stretch;
  justify-content: center;
  gap: 12px;
  width: 100%;
  margin-top: 24px;
}

.confirm-actions button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  min-width: 120px;
  min-height: 44px;
  padding: 0 18px;
  border-radius: 9px;
  font: inherit;
  font-size: 12px;
  font-weight: 750;
  line-height: 1;
  white-space: nowrap;
  cursor: pointer;
  box-sizing: border-box;
}

.confirm-actions .cancel-button {
  border: 1px solid #d8cec0;
  background: #ffffff;
  color: #3f4548;
}

.confirm-actions .cancel-button:hover {
  background: #f7f4ee;
  border-color: #b58a3a;
  color: #102a43;
}

.confirm-actions .delete-confirm-button {
  border: 1px solid #9b4d48;
  background: #9b4d48;
  color: #ffffff;
}

.confirm-actions .delete-confirm-button:hover {
  background: #8b3430;
  border-color: #8b3430;
}
      /* ========================= RESPONSIVE ========================= */
      @media (max-width: 1100px) {
        .sidebar { width: 235px; }
        .topbar, .content { padding-left: 32px; padding-right: 32px; }
        .project-row { grid-template-columns: 155px minmax(0, 1fr); }
        .project-image { width: 155px; height: 112px; }
        .project-actions { grid-column: 2; justify-content: flex-start; min-width: 0; }
      }

      @media (max-width: 900px) {
        .sidebar {
          width: 100%;
          min-height: auto;
          position: static;
          padding: 14px 16px;
          flex-direction: row;
          align-items: center;
          gap: 14px;
        }

        .admin-layout { display: block; }
        .sidebar-brand { width: auto; padding: 0 12px 0 0; border-bottom: 0; border-right: 1px solid rgba(255,255,255,.12); }
        .sidebar-brand img { width: 130px; max-height: 48px; }
        .brand-divider, .sidebar-brand span, .sidebar-bottom { display: none; }
        .sidebar-nav { padding: 0; flex: 1; }
        .nav-item { width: fit-content; margin: 0; min-height: 43px; padding: 0 12px; }
        .topbar { position: static; }
        .mobile-logout {
          display: inline-flex;
          min-height: 34px;
          align-items: center;
          padding: 0 11px;
          border: 1px solid #ddd4c8;
          border-radius: 999px;
          background: #fff;
          color: #687078;
          font: inherit;
          font-size: 10px;
          font-weight: 700;
          cursor: pointer;
        }
        .stats-grid { grid-template-columns: 1fr; }
      }

      @media (max-width: 700px) {
        .topbar { min-height: 92px; padding: 20px 22px; }
        .secure-status { display: none; }
        .content { padding: 30px 22px 55px; }
        .section-header { align-items: stretch; flex-direction: column; margin-bottom: 24px; }
        .section-header h2 { font-size: 24px; }
        .new-project-button { width: 100%; }
        .project-row { grid-template-columns: 1fr; gap: 15px; padding: 17px; }
        .project-image { width: 100%; height: 185px; }
        .project-actions { grid-column: auto; display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); width: 100%; }
        .action-button { width: 100%; }
        .delete-project { grid-column: 1 / -1; }
        .projects-card-header { padding: 16px 17px; }
        .form-grid { grid-template-columns: 1fr; }
        .form-field.full { grid-column: auto; }
        .modal-backdrop { padding: 12px; }
        .modal { max-height: calc(100vh - 24px); border-radius: 13px; }
        .modal-header, .modal form { padding-left: 19px; padding-right: 19px; }
      }

      @media (max-width: 430px) {
        .sidebar { padding: 11px 12px; }
        .sidebar-brand img { width: 112px; }
        .nav-item span:last-child { display: none; }
        .nav-item { padding: 0 10px; }
        .topbar { padding: 18px 17px; }
        .content { padding: 25px 17px 48px; }
        .stat-card { padding: 18px; }
        .project-image { height: 175px; }
        .project-actions { grid-template-columns: 1fr 1fr; }
        .modal-header h2 { font-size: 20px; }
        .modal-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
}

.confirm-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.confirm-actions button {
  width: 100%;
  min-width: 0;
}
        .cancel-button, .save-button, .delete-confirm-button { width: 100%; }
        .confirm-modal { padding: 24px 20px; }
      }
    </style>

